# Contenitore.kasmvnc — KasmVNC + KDE Plasma on X11, for the REMOTIX vs KasmVNC comparison
# (banchi/16-stress/16-kasmvnc.py, fasi/20 §9).  Built ROOTLESS by nicfio, storage on /media.
# KasmVNC from its OFFICIAL release package (GitHub kasmtech/KasmVNC, Debian 13 «trixie» build),
# configuration AS THE PACKAGE SHIPS IT: the only additions are the test user, its password, and the
# session command (startplasma-x11).  Self-signed TLS = Debian's snakeoil (ssl-cert).
FROM docker.io/library/debian:trixie
ARG KASMVNC_VERSION=1.5.0
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl ssl-cert dbus-x11 x11-utils xdotool procps \
      plasma-desktop kwin-x11 plasma-workspace konsole breeze \
      mpv mesa-va-drivers intel-media-va-driver libgl1-mesa-dri fonts-dejavu \
 && curl -fsSL -o /tmp/kasmvnc.deb \
      https://github.com/kasmtech/KasmVNC/releases/download/v${KASMVNC_VERSION}/kasmvncserver_trixie_${KASMVNC_VERSION}_amd64.deb \
 && apt-get install -y /tmp/kasmvnc.deb && rm -f /tmp/kasmvnc.deb \
 && rm -rf /var/lib/apt/lists/*
# the self-signed TLS: Debian's snakeoil (not generated by the postinst in a build)
# ⚠ readable by all: `--group-add keep-groups` (needed for /dev/dri rootless) drops the ssl-cert group
RUN make-ssl-cert generate-default-snakeoil --force-overwrite \
 && chmod 755 /etc/ssl/private && chmod 644 /etc/ssl/private/ssl-cert-snakeoil.key
# the test user (password set at run time by 16-kasmvnc.py, never baked in)
RUN useradd -m -s /bin/bash -G ssl-cert,video,render kasm 2>/dev/null || useradd -m -s /bin/bash -G ssl-cert,video kasm
USER kasm
WORKDIR /home/kasm
RUN mkdir -p .vnc && printf '#!/bin/sh\nexec dbus-launch --exit-with-session startplasma-x11\n' > .vnc/xstartup \
 && chmod +x .vnc/xstartup && touch .vnc/.de-was-selected
