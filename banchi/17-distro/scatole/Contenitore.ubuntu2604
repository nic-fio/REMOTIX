# Contenitore.ubuntu2604 — fase 17: la scatola «cliente» di Ubuntu 26.04 LTS col desktop DESKTOP
# (gnome = ubuntu-desktop, kde = kubuntu-desktop, xfce = xubuntu-desktop, lxqt = lubuntu-desktop: gli
# stessi di 17-vm.sh vesti). Il resto come Contenitore.debian13.
# ⚠ Una differenza dichiarata dalla macchina vera: in una scatola snapd non gira (niente squashfs né
#   apparmor), e i pacchetti «di passaggio» che installano uno snap (firefox, thunderbird) falliscono
#   nel loro preinst. Si tengono FUORI con una preferenza di apt (priorità -1): il browser del giro sta
#   fuori dalla scatola, e REMOTIX non dipende da loro.
FROM docker.io/library/ubuntu:26.04
ARG DESKTOP
ARG PORTA_SSH=8600
ENV DEBIAN_FRONTEND=noninteractive
RUN case "$DESKTOP" in gnome|kde|xfce|lxqt) ;; *) echo "DESKTOP=«$DESKTOP»: gnome|kde|xfce|lxqt" >&2; exit 2 ;; esac
RUN printf 'Package: firefox thunderbird chromium-browser\nPin: release *\nPin-Priority: -1\n' > /etc/apt/preferences.d/t17-niente-snap
RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus dbus-user-session libpam-systemd \
        sudo procps iproute2 ca-certificates curl openssh-server \
    && rm -rf /var/lib/apt/lists/*
RUN case "$DESKTOP" in gnome) P=ubuntu-desktop ;; kde) P=kubuntu-desktop ;; xfce) P=xubuntu-desktop ;; lxqt) P=lubuntu-desktop ;; esac \
    && apt-get update && apt-get install -y -q "$P" \
    && rm -rf /var/lib/apt/lists/*
COPY comune.sh /usr/local/sbin/t17-comune
RUN sh /usr/local/sbin/t17-comune "$PORTA_SSH" ssh.service
COPY chiave-banco.pub /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
