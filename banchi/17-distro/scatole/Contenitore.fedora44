# Contenitore.fedora44 — phase 17: the "customer" box of Fedora 44 with the desktop DESKTOP, from the official
# dnf groups (the same as 17-vm.sh vesti): workstation-product-environment,
# kde-desktop-environment, xfce-desktop-environment, lxqt-desktop-environment. NO RPM Fusion:
# the GPU's H.264 is the administrator's (17-amministratore.sh). The rest as in Contenitore.debian13.
FROM registry.fedoraproject.org/fedora:44
ARG DESKTOP
ARG PORTA_SSH=8600
RUN case "$DESKTOP" in gnome|kde|xfce|lxqt) ;; *) echo "DESKTOP=\"$DESKTOP\": gnome|kde|xfce|lxqt" >&2; exit 2 ;; esac
RUN dnf -y install systemd dbus sudo procps-ng iproute ca-certificates curl openssh-server shadow-utils \
    && dnf clean all
RUN case "$DESKTOP" in gnome) G=workstation-product-environment ;; *) G=$DESKTOP-desktop-environment ;; esac \
    && dnf -y group install "$G" && dnf clean all
COPY comune.sh /usr/local/sbin/t17-comune
RUN sh /usr/local/sbin/t17-comune "$PORTA_SSH" sshd.service
COPY chiave-banco.pub /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/sbin/init"]
