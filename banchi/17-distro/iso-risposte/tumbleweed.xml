<?xml version="1.0"?>
<!DOCTYPE profile>
<!--
  REMOTIX phase 17 — openSUSE Tumbleweed from the NET ISO, automatic installation (AutoYaST).
  The patterns are those of the default role "Desktop con KDE Plasma" (openSUSE's
  control.xml: kde x11 base enhanced_base x11_yast yast2_basis); SELinux enforcing and
  firewalld on as default; the user's automatic login and the same password
  for root are the installer's ALREADY ticked boxes. Partitioning is not
  written: the proposal is taken (btrfs with snapper). The bench's additions: [banco].
  Placeholders filled in by 17-vm.sh: @UTENTE@ @HASH@ @CHIAVE@ @NOME@
-->
<profile xmlns="http://www.suse.com/1.0/yast2ns" xmlns:config="http://www.suse.com/1.0/configns">
  <general>
    <mode>
      <confirm config:type="boolean">false</confirm>
      <final_reboot config:type="boolean">true</final_reboot>
    </mode>
  </general>
  <language>
    <language>it_IT</language>
    <languages/>
  </language>
  <keyboard>
    <keymap>italian</keymap>
  </keyboard>
  <timezone>
    <hwclock>UTC</hwclock>
    <timezone>Europe/Rome</timezone>
  </timezone>
  <networking>
    <keep_install_network config:type="boolean">true</keep_install_network>
  </networking>
  <host>
    <hosts config:type="list"/>
  </host>
  <software>
    <!-- the NET offers four products (Aeon, Kalpa, MicroOS, openSUSE): Tumbleweed is chosen -->
    <products config:type="list">
      <product>openSUSE</product>
    </products>
    <install_recommended config:type="boolean">true</install_recommended>
    <patterns config:type="list">
      <pattern>kde</pattern>
      <pattern>x11</pattern>
      <pattern>base</pattern>
      <pattern>enhanced_base</pattern>
      <pattern>x11_yast</pattern>
      <pattern>yast2_basis</pattern>
    </patterns>
  </software>
  <security>
    <lsm_select>selinux</lsm_select>
    <selinux_mode>enforcing</selinux_mode>
  </security>
  <firewall>
    <enable_firewall config:type="boolean">true</enable_firewall>
    <start_firewall config:type="boolean">true</start_firewall>
  </firewall>
  <login_settings>
    <autologin_user>@UTENTE@</autologin_user>
  </login_settings>
  <users config:type="list">
    <user>
      <username>@UTENTE@</username>
      <fullname>@UTENTE@</fullname>
      <encrypted config:type="boolean">true</encrypted>
      <user_password>@HASH@</user_password>
      <!-- [banco] the bench key -->
      <authorized_keys config:type="list">
        <listentry>@CHIAVE@</listentry>
      </authorized_keys>
    </user>
    <user>
      <username>root</username>
      <encrypted config:type="boolean">true</encrypted>
      <user_password>@HASH@</user_password>
    </user>
  </users>
  <services-manager>
    <default_target>graphical</default_target>
    <services>
      <!-- [banco] sshd: off by default in the desktop role -->
      <enable config:type="list">
        <service>sshd</service>
      </enable>
    </services>
  </services-manager>
  <scripts>
    <chroot-scripts config:type="list">
      <script>
        <chrooted config:type="boolean">true</chrooted>
        <filename>rx-banco.sh</filename>
        <interpreter>shell</interpreter>
        <source><![CDATA[
# [banco] passwordless sudo, and ssh opened in the firewall (closed by default)
echo '@UTENTE@ ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/90-banco
chmod 440 /etc/sudoers.d/90-banco
firewall-offline-cmd --zone=public --add-service=ssh
echo @NOME@ > /etc/hostname
]]></source>
      </script>
    </chroot-scripts>
  </scripts>
</profile>
