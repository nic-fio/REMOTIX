#### REMOTIX phase 17 — Debian 13 from the netinst ISO, automatic installation (preseed)
# The choices are the installer's DEFAULTS, as an Italian customer pressing
# "Avanti" would make them; the only additions of the bench are marked with [banco].
# Placeholders filled in by 17-vm.sh: @UTENTE@ @HASH@ @CHIAVE@ @NOME@

d-i debian-installer/locale string it_IT.UTF-8
d-i debian-installer/language string it
d-i debian-installer/country string IT
d-i keyboard-configuration/xkb-keymap select it

d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string @NOME@
d-i netcfg/get_domain string
d-i netcfg/hostname string @NOME@
d-i hw-detect/load_firmware boolean true

d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string

# No password for root: the installer then puts the first user in the sudo
# group (it is the choice the installer offers when root is left empty).
d-i passwd/root-login boolean false
d-i passwd/user-fullname string @UTENTE@
d-i passwd/username string @UTENTE@
d-i passwd/user-password-crypted password @HASH@

d-i clock-setup/utc boolean true
d-i time/zone string Europe/Rome
d-i clock-setup/ntp boolean true

# The whole disk, "all files in one partition" (the default proposal)
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-md/confirm boolean true
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true

d-i apt-setup/cdrom/set-first boolean false
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/services-select multiselect security, updates
d-i apt-setup/disable-cdrom-entries boolean true

# The tasks offered by default: desktop environment + GNOME + system utilities.
# [banco] ssh-server: not a default, needed to drive the machine.
tasksel tasksel/first multiselect desktop, gnome-desktop, standard, ssh-server
d-i pkgsel/upgrade select safe-upgrade
popularity-contest popularity-contest/participate boolean false

d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string default
d-i finish-install/reboot_in_progress note
d-i cdrom-detect/eject boolean false

# [banco] the bench key and passwordless sudo, INSIDE the installation
d-i preseed/late_command string in-target sh -c 'install -d -m 700 -o @UTENTE@ -g @UTENTE@ /home/@UTENTE@/.ssh && echo "@CHIAVE@" > /home/@UTENTE@/.ssh/authorized_keys && chown @UTENTE@:@UTENTE@ /home/@UTENTE@/.ssh/authorized_keys && chmod 600 /home/@UTENTE@/.ssh/authorized_keys && echo "@UTENTE@ ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-banco && chmod 440 /etc/sudoers.d/90-banco'
