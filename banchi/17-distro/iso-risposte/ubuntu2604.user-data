#cloud-config
# REMOTIX phase 17 — Ubuntu 26.04 from the DESKTOP ISO, automatic installation (autoinstall).
# The source is the ISO's default (ubuntu-desktop-minimal, "Selezione predefinita");
# the only additions of the bench are marked with [bench].
# Placeholders filled in by 17-vm.sh: @ACCOUNT@ @HASH@ @KEY@ @LABEL_NAME@
autoinstall:
  version: 1
  locale: it_IT.UTF-8
  keyboard:
    layout: it
  timezone: Europe/Rome
  identity:
    hostname: @LABEL_NAME@
    realname: @ACCOUNT@
    username: @ACCOUNT@
    password: '@HASH@'
  # [bench] openssh-server: not there by default on the desktop
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - '@KEY@'
  storage:
    layout:
      name: direct
  late-commands:
    # [bench] passwordless sudo (the user is already in the sudo group, like the default first user)
    - "echo '@ACCOUNT@ ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/90-banco && chmod 440 /target/etc/sudoers.d/90-banco"
  shutdown: reboot
