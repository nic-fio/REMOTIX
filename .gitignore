# Cloni upstream dei progetti di riferimento (~630 MB): sono versionati a monte,
# si ricreano con `git clone`. Qui servono da leggere, non da conservare.
reference-gnome/
reference-kde/
reference-lxqt/
reference-xfce/
reference-cinnamon/

# Artefatti di compilazione
build/
target/
*.o

# Le registrazioni di B4 le rigenera `01-b4-registrazioni.py`: la fonte e'
# il generatore, non i file binari.
banchi/b4-registrazioni/

# i .pyc di py_compile: non sono nostri e non servono a nessuno
__pycache__/

# Le copie guastate di B12 le rigenera `01-b12-guasti.py`: sono derivate,
# e una copia col guasto dentro non va conservata.
banchi/01-b12-copie/
