#!/bin/sh
# remotix-pam-hook — puts (and keeps, and takes away) REMOTIX's line in the PAM stacks of the graphical login screens.
#
#     remotix-pam-hook apply  [dm...]     make sure the line is there (idempotent; a change is said on stderr)
#     remotix-pam-hook check  [dm...]     the same as `apply`, plus one summary line (the service runs it at every start)
#     remotix-pam-hook remove [dm...]     take it away completely, leaving every file as it was before REMOTIX
#     remotix-pam-hook [--test-root DIR] prepare [dm...]              (package triggers: before sddm is updated/removed, see prepare_one)
#     remotix-pam-hook --test-root DIR apply|check|remove [dm...]     the same on a COPY: DIR/etc (the /etc/pam.d files) and DIR/vendor
#                                                                     (the /usr/lib/pam.d files); the only way to point it elsewhere
#
# WHAT THE LINE IS (the one of Debian/Ubuntu's pam-auth-update profile): in the `session` phase,
#     session optional pam_exec.so quiet /usr/libexec/remotix/remotix-local-login
# so that a LOCAL graphical login closes the user's remote desktop FIRST (src/local_login.c; DECISIONS-11 §11.57, decision D4).
# ⛔ WHERE: in the `session` phase, right AFTER the first `pam_selinux.so close` line (the first session line of gdm's and plasmalogin's
#    stacks) — i.e. BEFORE `pam_selinux open` — not after pam_systemd as on Debian.  `[M]` 21 Nov 2026, gdm 51 and plasmalogin on Fedora 45:
#    (1) gdm's own worker already puts XDG_SEAT, XDG_SESSION_TYPE and XDG_VTNR in the PAM environment before the session stack runs, which
#        is all the hook looks at (pam_systemd's job on Debian); (2) `pam_selinux open` sets the exec context of the NEXT exec, and a
#        `pam_exec` line after it would spend that exec on the hook (AVC `entrypoint`, the hook is refused and the user's desktop would
#        then start in the wrong context).  Each login screen has to be proved the same way before it is switched on.
#    (3) NOT before `pam_selinux close` either: the stack also runs at CLOSE_session, and the helper of plasmalogin keeps, from `open`, the exec
#        context of the user (it is the same process): a `pam_exec` that came first would try to `exec` the hook with it at logout and be refused
#        (AVC `entrypoint`, `[M]` 23:09, 6.8.3 and 6.8.1).  `pam_selinux close` runs first at close and gives the exec context back.
#
# WHY A SCRIPT AND NOT pam-auth-update / authselect (Fedora 45): authselect rewrites /etc/pam.d/{system,password}-auth and postlogin
# from the administrator's profile, and a package must not replace that choice; so nothing generated by authselect is ever touched.
# The login screens' OWN files are used (gdm: /usr/lib/pam.d/gdm-*, vendor files of the package gdm):
#   · a vendor file with no file of the same name in /etc/pam.d  → /etc/pam.d/<name> is made: a copy of the CURRENT vendor file plus our block,
#     first line a marker that says it is ours; REGENERATED at every `apply`, so it is never older than the vendor file (the package's
#     triggers run `apply` whenever gdm is installed or updated);
#   · a file of the same name in /etc/pam.d that is NOT ours (the administrator's, or another package's %config) → only our marked block
#     is added to it, and `remove` takes away only that block;
#   · a file of ours whose vendor file has gone (the login screen was removed) → deleted.
# ⛔ A broken PAM file shuts everybody out of the machine: every file is composed in a temporary file in the same folder, step by step
#    (the status of EVERY command is looked at: no pipe whose failure is lost), checked (every line has the shape of a PAM line, there is a
#    `session` line, and the composed file MINUS our block and our marker is byte for byte the source it was made from: a truncated file
#    cannot pass), given the owner, mode and SELinux label it must have, and only then renamed over the target.  If anything does not
#    look right the file is NOT touched and the reason is said.  A block with a BEGIN and no END is not touched either.  Symbolic links
#    (authselect's) are never touched.
# ⛔ If OUR generated copy cannot be refreshed (the vendor file is unreadable, the composition failed), it is DELETED, so that the vendor's
#    new file is in force without the hook: no hook is better than a login file that is out of date.  Said clearly.
#    The exit status is 0 if all went well, 1 if something was skipped or removed (callers ignore it: packaging never fails because of the hook).
#
# THE LIST OF LOGIN SCREENS: `DEFAULT_DMS` below, or the names on the command line.  Active, each one proved on the real machine (`[M]` 21-22 Nov 2026):
#   gdm; plasmalogin (KDE: its helper puts XDG_SEAT, XDG_SESSION_TYPE, XDG_SESSION_CLASS and XDG_VTNR in the PAM environment BEFORE `pam_selinux open`);
#   lightdm (XFCE: XDG_SEAT, XDG_SESSION_TYPE=x11, XDG_VTNR there, XDG_SESSION_CLASS not yet: local_login.c takes an empty class);
#   sddm (LXQt: XDG_SEAT, XDG_SESSION_TYPE=wayland, XDG_SESSION_CLASS=user, XDG_VTNR there).
# ⚠ sddm is the odd one: its PAM files live in /etc/pam.d and BELONG to the sddm package (%config), there is no file in /usr/lib/pam.d.  So the block is
#   added IN PLACE (the "admin file" branch of apply_one) and taken out again byte for byte; `rpm -V sddm` shows the file modified while we are installed.
set -u

DEFAULT_DMS="gdm plasmalogin lightdm sddm"
HOOK=/usr/libexec/remotix/remotix-local-login
VENDOR=/usr/lib/pam.d
ETC=/etc/pam.d
TESTMODE=
if [ "${1:-}" = --test-root ]; then       # an explicit option, never the environment: this script writes PAM files as root
	[ -n "${2:-}" ] && [ -d "$2" ] || { echo "remotix-pam-hook: --test-root needs a folder" >&2; exit 2; }
	ETC=$2/etc; VENDOR=$2/vendor; TESTMODE=1; shift 2
fi
LINE="session    optional     pam_exec.so quiet $HOOK"
BEGIN='# BEGIN remotix-pam-hook: closes the remote desktop of the user before a local graphical login (REMOTIX package; removed with it)'
END='# END remotix-pam-hook'
MARK='# remotix-pam-hook: GENERATED FILE'

say() { echo "remotix-pam-hook: $*" >&2; }
RC=0
skip() { say "⚠ $*"; RC=1; }

# the PAM services of a login screen: names of vendor/etc files that OPEN A USER SESSION (not the greeter's own, not the helper substacks)
# Written to a variable by the caller (no pipe: an unknown name must reach RC).
known_dm() { case $1 in gdm|lightdm|sddm|plasmalogin) return 0 ;; *) return 1 ;; esac; }
dm_candidates() {
	case $1 in
	gdm)         for d in "$VENDOR" "$ETC"; do for f in "$d"/gdm-*; do if [ -e "$f" ]; then basename "$f"; fi; done; done ;;
	lightdm)     for d in "$VENDOR" "$ETC"; do for f in "$d"/lightdm "$d"/lightdm-autologin; do if [ -e "$f" ]; then basename "$f"; fi; done; done ;;
	sddm)        for d in "$VENDOR" "$ETC"; do for f in "$d"/sddm "$d"/sddm-autologin; do if [ -e "$f" ]; then basename "$f"; fi; done; done ;;
	plasmalogin) for d in "$VENDOR" "$ETC"; do for f in "$d"/plasmalogin*; do if [ -e "$f" ]; then basename "$f"; fi; done; done ;;
	esac
	return 0
}
services_of() {
	cand=$(dm_candidates "$1")
	for s in $(printf '%s\n' $cand | sort -u); do
		case $s in
		gdm-launch-environment|*-substack|*-greeter|*.rpmsave|*.rpmnew|*.rpmorig|.remotix-hook.*) continue ;;
		esac
		echo "$s"
	done
}

has_session() { grep -Eq '^[[:space:]]*-?session[[:space:]]' "$1"; }

# every line of the file is empty, a comment, or has the shape of a PAM line (type, control, module...)
shape_ok() {
	awk 'BEGIN{bad=0} /^[[:space:]]*(#|$)/ {next} /^[[:space:]]*-?(auth|account|password|session)[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+/ {next} {bad=1} END{exit bad}' "$1"
}

# the block is whole (BEGIN, then END) or absent; anything else is a file we do not understand
block_state() {   # prints: none | whole | broken
	b=$(grep -cxF "$BEGIN" "$1"); e=$(grep -cxF "$END" "$1")
	if [ "$b" = 0 ] && [ "$e" = 0 ]; then echo none
	elif [ "$b" = 1 ] && [ "$e" = 1 ] && [ "$(grep -nxF "$BEGIN" "$1" | cut -d: -f1)" -lt "$(grep -nxF "$END" "$1" | cut -d: -f1)" ]; then echo whole
	else echo broken; fi
}

strip_block() {   # <in >out : without our block; fails (status 3) if a BEGIN is not closed by an END
	awk -v b="$BEGIN" -v e="$END" '$0==b {skip=1; next} skip && $0==e {skip=0; next} !skip {print} END{if (skip) exit 3}'
}

add_block() {     # <in >out : our block right AFTER the first `pam_selinux.so close` session line (else BEFORE the first session line)
	awk -v b="$BEGIN" -v e="$END" -v l="$LINE" '
		{ lines[NR]=$0 }
		/^[[:space:]]*-?session[[:space:]]/ {
			if (!first) first=NR
			if (!after && $0 ~ /pam_selinux\.so/ && $0 ~ /[[:space:]]close([[:space:]]|$)/) after=NR
		}
		END {
			pos = after ? after + 1 : first
			for (i = 1; i <= NR; i++) { if (i == pos) { print b; print l; print e } print lines[i] }
			if (pos > NR) { print b; print l; print e }
		}'
}

is_ours() { [ -f "$1" ] && [ ! -L "$1" ] && head -n 1 "$1" | grep -q "^$MARK"; }

mktmp() { mktemp "$ETC/.remotix-hook.XXXXXX"; }

# ---- files of ANOTHER package that we change IN PLACE (sddm: /etc/pam.d/sddm* are %config(noreplace) files of the sddm package) --------------------
# ⛔ rpm decides what to do with a config file (replace it, keep it and write .rpmnew, save it as .rpmsave) BEFORE it runs any scriptlet or trigger
#    (`rpmtsPrepare`), by comparing the file on disk with the old package's digest.  So taking our block out in %triggerprein is TOO LATE for that
#    decision (`[M]` 22 Nov 2026: the update of sddm kept our text and wrote .rpmnew; the removal left .rpmsave).  What we do instead:
#    · `prepare` (from %triggerprein / %triggerun): if the file minus our block is EXACTLY what the package shipped (its digest in the rpm database),
#      we note that digest in a marker (the file was "pristine"), then take the block out;
#    · `apply` (from %triggerin / %triggerpostun): if a marker is there and rpm left a .rpmnew whose old text we still hold, or a .rpmsave whose digest is
#      the marker's, we put things as rpm would have done for an unmodified file (the .rpmnew becomes the file; the .rpmsave, identical to the old vendor
#      text, goes away).  A file the administrator HAD changed has no marker: rpm's own outcome (.rpmnew / .rpmsave with his text) stays as it is.
#    Nothing is ever deleted or replaced unless its digest proves it is the old vendor text.
PRISTINE=/var/lib/remotix/pam-pristine
[ -n "$TESTMODE" ] && PRISTINE=$(dirname "$ETC")/pristine
sha_of() { sha256sum | cut -d' ' -f1; }
db_digests() {   # <file> : the digests the rpm database has for this path, one per package that owns it (EMPTY if none).
	# ⚠ DURING an update both the old and the new package are in the database (the old one goes at %triggerpostun): so there can be two lines.
	if [ -n "$TESTMODE" ]; then cat "$VENDOR/$(basename "$1").digest" 2>/dev/null; return 0; fi
	timeout 10 rpm -q --qf '[%{FILENAMES}\t%{FILEDIGESTS}\n]' -f "$1" 2>/dev/null | awk -F'\t' -v f="$1" '$1==f {print $2}'
}
db_digest() { db_digests "$1" | head -n 1; }   # the first one: what prepare_one needs, when only the old package is there
prepare_one() {   # prepare_one <service>
	s=$1; loc=$ETC/$s
	[ -f "$loc" ] && [ ! -L "$loc" ] || return 0
	is_ours "$loc" && return 0                                  # our generated copy of a vendor file in /usr/lib/pam.d: not rpm's business
	d=$(db_digest "$loc")
	cur=$(strip_block < "$loc" | sha_of)
	if [ -n "$d" ] && [ ${#d} = 64 ] && [ "$cur" = "$d" ]; then
		# line 1: the digest of the old vendor text; line 2: the digest of a .rpmnew that was ALREADY there (an old one from an earlier update), or "none":
		# an unchanged old .rpmnew is never mistaken for the one of this update (see adopt_one)
		oldnew=none; [ -f "$loc.rpmnew" ] && oldnew=$(sha_of < "$loc.rpmnew")
		mkdir -p "$PRISTINE" 2>/dev/null && chmod 700 "$PRISTINE" 2>/dev/null && printf '%s\n%s\n' "$d" "$oldnew" > "$PRISTINE/$s"
	else
		rm -f "$PRISTINE/$s"
	fi
	remove_one "$s"
}
adopt_one() {   # adopt_one <service> : after the package's update/removal, see prepare_one
	s=$1; loc=$ETC/$s; m=$PRISTINE/$s
	[ -f "$m" ] || return 0
	d=$(sed -n 1p "$m"); oldnew=$(sed -n 2p "$m")
	# the .rpmnew is put in force only if it is PROVED to be this transaction's: the file we hold (minus our block) is still the old vendor text,
	# the .rpmnew is not the one that was already there before (same digest as then = never touched by this update), it differs from the old text,
	# and its digest is one the rpm database has NOW for this path (the new package's: during the update the old one is still listed too).  In any doubt nothing is touched; the marker is used up.
	if [ -f "$loc.rpmnew" ]; then
		why=
		if [ ! -f "$loc" ] || [ -L "$loc" ]; then
			why="the file is missing or a link"
		elif [ "$(strip_block < "$loc" | sha_of)" != "$d" ]; then
			why="the file minus our block is no longer the old vendor text (somebody changed it)"
		else
			rn=$(sha_of < "$loc.rpmnew")
			if [ "$rn" = "$oldnew" ]; then why="the .rpmnew is the one that was already there before this update"
			elif [ "$rn" = "$d" ]; then why="the .rpmnew is identical to the old vendor text"
			elif ! db_digests "$loc" | grep -qxF "$rn"; then why="the .rpmnew is not a version the rpm database knows for this path"
			elif mv -f "$loc.rpmnew" "$loc"; then
				command -v restorecon >/dev/null 2>&1 && restorecon -F "$loc" 2>/dev/null
				say "$loc: the package's new version is now in force (rpm had kept the old text only because of our block, and wrote it as $s.rpmnew)"
			else
				why="the move failed"
			fi
		fi
		# a refusal is said, never silent: the .rpmnew stays where rpm put it and the administrator can look
		[ -z "$why" ] || skip "$loc.rpmnew NOT adopted ($why): left as rpm wrote it"
	fi
	if [ -f "$loc.rpmsave" ] && [ "$(sha_of < "$loc.rpmsave")" = "$d" ]; then
		rm -f "$loc.rpmsave" && say "removed $loc.rpmsave: exactly the package's old text, which rpm saved only because of our block"
	fi
	rm -f "$m"
}
dm_of_service() { case $1 in sddm|sddm-autologin) echo sddm ;; *) echo "" ;; esac; }
adopt_all() {   # adopt_all <dm...> : the markers of the given login screens
	for m in "$PRISTINE"/*; do
		[ -f "$m" ] || continue
		sv=$(basename "$m"); dmn=$(dm_of_service "$sv")
		for want in "$@"; do [ "$dmn" = "$want" ] && adopt_one "$sv"; done
	done
}

# put <composed> <target> <ref-for-owner-and-label or empty> <source> <ours 0|1>
# <source> is the file the composed one was made from (the vendor file, or the target's own text); composed minus our block (and our
# marker line, if the file is ours) must be IDENTICAL to it, or nothing is installed.
put() {
	tmp=$1 target=$2 ref=$3 src=$4 ours=$5
	[ -s "$tmp" ] || { skip "$target: composed file is empty, left alone"; rm -f "$tmp"; return 1; }
	has_session "$tmp" || { skip "$target: composed file has no session line, left alone"; rm -f "$tmp"; return 1; }
	shape_ok "$tmp" || { skip "$target: composed file has a line that is not a PAM line, left alone"; rm -f "$tmp"; return 1; }
	chk=$(mktemp "$ETC/.remotix-hook.XXXXXX") || { skip "$target: cannot write the check file"; rm -f "$tmp"; return 1; }
	want=$(mktemp "$ETC/.remotix-hook.XXXXXX") || { skip "$target: cannot write the check file"; rm -f "$tmp" "$chk"; return 1; }
	ok=1
	if [ "$ours" = 1 ]; then tail -n +2 "$tmp" > "$chk.1" || ok=0; strip_block < "$chk.1" > "$chk" || ok=0; rm -f "$chk.1"
	else strip_block < "$tmp" > "$chk" || ok=0; fi
	strip_block < "$src" > "$want" || ok=0
	if [ "$ok" = 1 ] && cmp -s "$chk" "$want"; then :; else
		skip "$target: the composed file is not the source plus our block (truncated or damaged), left alone"
		rm -f "$tmp" "$chk" "$want"; return 1
	fi
	rm -f "$chk" "$want"
	chown root:root "$tmp" 2>/dev/null
	if [ -n "$ref" ] && [ -e "$ref" ]; then
		chmod --reference="$ref" "$tmp" 2>/dev/null || chmod 0644 "$tmp"
		chcon --reference="$ref" "$tmp" 2>/dev/null || true
	else
		chmod 0644 "$tmp"
		command -v restorecon >/dev/null 2>&1 && restorecon -F "$tmp" 2>/dev/null
	fi
	mv -f "$tmp" "$target" || { skip "$target: could not be replaced"; rm -f "$tmp"; return 1; }
	command -v restorecon >/dev/null 2>&1 && restorecon -F "$target" 2>/dev/null
	return 0
}

# compose <vendor-file> <out>: the generated file (marker + vendor + block); every step's status is looked at
compose_ours() {
	vend=$1 out=$2
	echo "$MARK — a copy of $vend with the REMOTIX hook added; regenerated by the REMOTIX package, do not edit (remove the package to get the vendor file back)" > "$out" || return 1
	t1=$(mktemp "$ETC/.remotix-hook.XXXXXX") || return 1
	strip_block < "$vend" > "$t1" || { rm -f "$t1"; return 1; }
	add_block < "$t1" >> "$out" || { rm -f "$t1"; return 1; }
	rm -f "$t1"
}

# a refresh of OUR copy failed: take the copy away, so that the vendor's file is in force (no hook)
drop_stale() {
	if is_ours "$1"; then
		rm -f "$1" && say "⚠ $1 could NOT be refreshed: OUR out-of-date copy was DELETED so that the vendor file is in force; local logins will NOT close the remote desktop first until this works again"
		RC=1
	fi
}

apply_one() {   # apply_one <service>
	s=$1; vend=$VENDOR/$s; loc=$ETC/$s
	if [ -z "$TESTMODE" ] && [ ! -x "$HOOK" ]; then
		skip "$HOOK is not there: nothing is added to $s"; drop_stale "$loc"; return
	fi
	if [ -L "$loc" ]; then skip "$loc is a symbolic link (authselect's?): not touched"; return; fi
	if [ -e "$loc" ] && is_ours "$loc"; then
		if [ ! -f "$vend" ]; then rm -f "$loc" && say "removed $loc (its vendor file is gone)"; return; fi
		if [ ! -s "$vend" ] || ! has_session "$vend" || [ "$(block_state "$vend")" != none ]; then
			skip "$vend unreadable, without session lines or with a block of ours"; drop_stale "$loc"; return
		fi
		t=$(mktmp) || { skip "cannot write in $ETC"; drop_stale "$loc"; return; }
		if ! compose_ours "$vend" "$t"; then skip "$loc: the composition failed"; rm -f "$t"; drop_stale "$loc"; return; fi
		if cmp -s "$t" "$loc"; then rm -f "$t"
		elif put "$t" "$loc" "$loc" "$vend" 1; then say "regenerated $loc from $vend"
		else drop_stale "$loc"; fi
	elif [ -e "$loc" ]; then
		has_session "$loc" || { skip "$loc has no session line: not touched"; return; }
		[ "$(block_state "$loc")" != broken ] || { skip "$loc has a BEGIN of ours without its END (or the reverse): not touched"; return; }
		t=$(mktmp) || { skip "cannot write in $ETC"; return; }
		t1=$(mktemp "$ETC/.remotix-hook.XXXXXX") || { skip "cannot write in $ETC"; rm -f "$t"; return; }
		if strip_block < "$loc" > "$t1" && add_block < "$t1" > "$t"; then
			rm -f "$t1"
			if cmp -s "$t" "$loc"; then rm -f "$t"; elif put "$t" "$loc" "$loc" "$loc" 0; then say "added the hook block to $loc"; fi
		else rm -f "$t" "$t1"; skip "$loc: the composition failed, not touched"; fi
	elif [ -f "$vend" ]; then
		has_session "$vend" || return                      # a vendor file that opens no session: not ours to hook
		[ "$(block_state "$vend")" = none ] || { skip "$vend has a block of ours: not touched"; return; }
		t=$(mktmp) || { skip "cannot write in $ETC"; return; }
		if ! compose_ours "$vend" "$t"; then skip "$s: the composition failed, nothing made"; rm -f "$t"; return; fi
		put "$t" "$loc" "" "$vend" 1 && say "made $loc from $vend with the hook"
	fi
}

remove_one() {
	s=$1; loc=$ETC/$s
	[ -L "$loc" ] && return
	[ -e "$loc" ] || return
	if is_ours "$loc"; then rm -f "$loc" && say "removed $loc"; return; fi
	[ "$(block_state "$loc")" = none ] && return
	if [ "$(block_state "$loc")" = broken ]; then skip "$loc has a BEGIN of ours without its END (or the reverse): not touched"; return; fi
	t=$(mktmp) || { skip "cannot write in $ETC"; return; }
	if ! strip_block < "$loc" > "$t"; then rm -f "$t"; skip "$loc: could not take the block out, not touched"; return; fi
	put "$t" "$loc" "$loc" "$loc" 0 && say "took the hook block out of $loc"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
named=$#                                   # names given on the command line: a LIMITED run (e.g. `remove sddm` from the package's triggers)
dms=${*:-$DEFAULT_DMS}
case $cmd in
apply|check|remove|prepare) ;;
*) echo "usage: $0 [--test-root DIR] apply|check|remove|prepare [gdm|lightdm|sddm|plasmalogin...]" >&2; exit 2 ;;
esac
[ -d "$ETC" ] || { say "$ETC is not there"; exit 1; }
n=0
[ "$cmd" = apply ] || [ "$cmd" = check ] && adopt_all $dms
for dm in $dms; do
	known_dm "$dm" || { skip "unknown login screen «$dm»"; continue; }
	svcs=$(services_of "$dm")
	for s in $svcs; do
		n=$((n + 1))
		case $cmd in remove) remove_one "$s" ;; prepare) prepare_one "$s" ;; *) apply_one "$s" ;; esac
	done
done
# `remove` also looks for OUR generated files whose vendor file is gone (a login screen that left before us) and for the temporary
# files of an interrupted run (that name pattern only)
# (only a full run: `remove sddm` must not touch the generated files of gdm, plasmalogin or lightdm)
if [ "$cmd" = remove ] && [ "$named" = 0 ]; then
	for f in "$ETC"/*; do is_ours "$f" && { rm -f "$f"; say "removed $f"; }; done
	for f in "$ETC"/.remotix-hook.*; do [ -e "$f" ] && { rm -f "$f"; say "removed the leftover $f"; }; done
	rm -rf "$PRISTINE" 2>/dev/null; [ -n "$TESTMODE" ] || rmdir /var/lib/remotix 2>/dev/null; true
fi
if [ "$cmd" = check ]; then
	bad=0
	for dm in $dms; do known_dm "$dm" || continue; for s in $(services_of "$dm"); do
		[ -f "$VENDOR/$s" ] || [ -f "$ETC/$s" ] || continue
		grep -qxF "$LINE" "$ETC/$s" 2>/dev/null || { bad=$((bad + 1)); say "⚠ the hook is NOT in $ETC/$s"; }
	done; done
	[ "$bad" = 0 ] && say "the hook is in place in the PAM stacks of: $dms ($n services)"
fi
exit $RC
