# remotix — the PAM service of the REMOTIX server.  ⭐ FEDORA 45 ONLY.
#
#   installed in /etc/pam.d/remotix   (by remotix.spec; %config(noreplace))
#
# ⭐ This is Fedora's /etc/pam.d/sshd, line by line, with ONE extra line at the top (root excluded) and the two `pam_env` lines of
#    the session part that Debian's file has too (see below).  The Debian/Ubuntu file `@include`d common-auth/-account/-session:
#    on Fedora those names do not exist; the stacks are `password-auth` (a link into /etc/authselect, rewritten by authselect:
#    whatever the administrator chose with authselect — sssd, faillock, ... — holds for REMOTIX as it does for ssh) and `postlogin`.
#
# -----------------------------------------------------------------------------
# ⛔ WHY IT EXISTS, AND WHY `login` IS NOT USED
#
# `SPECS.md` §4.2: "local PAM, service `remotix`, with the ban of the address after three failed attempts".  `login` is the LOCAL CONSOLE
# stack (pam_securetty & co.); sshd is the NETWORK access stack, and REMOTIX is a network access (decision D3: REMOTIX mirrors the
# system's authentication, it does not drift from it).
#
# ⛔ IF THIS FILE IS NOT THERE, EVERY RIGHT PASSWORD IS REFUSED: Linux-PAM falls back to the service `other`, which on Fedora is
#    `pam_deny` (the symptom would be "wrong user or password" for anyone, a diagnosis pointing at the password while the defect is a
#    missing file).  Hence the two protections in the program (invariant I7): `main.c` looks for this file at start-up and SAYS so if
#    it is not there; `authentication.c` tells in the log "PAM refused" from "PAM could not judge".
#
# ⭐ SELinux (step 2 of the Fedora plan): the two `pam_selinux` lines are the ones of sshd and they WORK because the server runs in its
#    own domain `remotix_t` (selinux/remotix.te), allowed to do what a login program does: `pam_selinux open` asks for the user's
#    context (unconfined_u:unconfined_r:unconfined_t, the same as a local or ssh login) and sets it for the next `exec`
#    (`child.c`, `become_and_exec()`).  Without the module the exec is refused (AVC `transition`); without the lines the user's
#    programs would stay in the service's own domain.
#
# ⛔ NO keyring: no `pam_gnome_keyring`, `pam_oo7` or `pam_kwallet` (decision D6, as on Debian and Ubuntu).  The authentication and
#    the opening of the session are two different PAM handles in two processes: the password is not there when the session opens.
#
# -----------------------------------------------------------------------------

# ── auth: "is this password right?"
#
# ⭐ ROOT EXCLUDED, and BEFORE the password (`phases/17` §4.3).  The only intended difference from sshd.  The file lists one name per
#    line; it is installed with `root` in it, owned by root and not writable by others (`pam_listfile` refuses it otherwise).
#  · in `auth` and `requisite`, not in `account`: with the line in `account` the root password would be TRIED anyway, and "right
#    password but account denied" answers differently from "wrong password" — an oracle for whoever guesses root's password;
#  · ⛔ `onerr=fail`: if the file is missing or badly written NOBODY gets in, and PAM's log says so (with `succeed` the lost file would
#    silently remove root's exclusion — a protection in a line that can be lost, that is what I7 forbids).
auth       requisite    pam_listfile.so item=user sense=deny file=/etc/remotix/denied-users onerr=fail
#
# `pam_faillock`, if the administrator has put it in the authselect profile (with-faillock), comes with the stack, as for ssh.
auth       substack     password-auth
auth       include      postlogin

# ── account: "is this account usable?"  (account expired, locked, ...)
#    ⚠ It is not an extra: `pam_authenticate` does not answer this question, and `authentication.c` calls `pam_acct_mgmt` on purpose.
account    required     pam_sepermit.so
account    required     pam_nologin.so
account    include      password-auth

password   include      password-auth

# ── session: `child.c` calls `pam_open_session`, and it is that call that makes the user's logind session be born — with
#    `pam_systemd`, which is in `password-auth` (`-session optional pam_systemd.so`).
#
# ⚠ `pam_loginuid` `required` like sshd: the service starts from systemd, without loginuid, and can write it.
session    required     pam_selinux.so close
session    required     pam_loginuid.so
session    required     pam_selinux.so open env_params
session    required     pam_namespace.so
session    optional     pam_keyinit.so force revoke
session    optional     pam_motd.so
session    include      password-auth
session    include      postlogin
# ⛔ The session's PATH and language come from these two `pam_env` lines (as in the Debian file): `child.c` takes the PATH that
#    `/etc/environment` gives, if there is one (Fedora has no such file by default: the child then uses its own fallback), and the locale
#    file is /etc/locale.conf, where Fedora keeps it (Debian: /etc/default/locale).  Do NOT add `user_readenv=1`: the user would choose
#    the PATH of their own session from ~/.pam_environment.
session    required     pam_env.so
session    required     pam_env.so envfile=/etc/locale.conf
