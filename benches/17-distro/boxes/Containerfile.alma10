# Containerfile.alma10 — phase 17: the "customer" box of AlmaLinux 10 with the desktop DESKTOP (only gnome =
# "Server with GUI", kde = "KDE Plasma Workspaces" from EPEL with CRB: the same as 17-vm.sh dress; XFCE and
# LXQt do not exist for Alma 10, phases/17 §3). EPEL here serves THE KDE DESKTOP, as for the customer: the GPU's
# H.264 (RPM Fusion) remains the administrator's. The rest as in Containerfile.debian13.
FROM quay.io/almalinuxorg/almalinux:10
ARG DESKTOP
ARG SSH_PORT=8600
RUN case "$DESKTOP" in gnome|kde) ;; *) echo "DESKTOP=\"$DESKTOP\": on Alma 10 only gnome|kde" >&2; exit 2 ;; esac
RUN dnf -y install systemd dbus sudo procps-ng iproute ca-certificates curl openssh-server shadow-utils dnf-plugins-core \
    && dnf clean all
# --allowerasing (26 Oct 2026): the alma:10 image carries coreutils-single, which the desktop groups replace with coreutils
RUN if [ "$DESKTOP" = gnome ]; then dnf -y --allowerasing group install "Server with GUI"; \
    else dnf -y install epel-release && dnf config-manager --set-enabled crb && dnf -y --allowerasing group install "KDE Plasma Workspaces"; fi \
    && dnf clean all
# ⛔ 27 Oct 2026: the official AlmaLinux CONTAINER image masks systemd-logind (/etc/systemd/system/systemd-logind.service
#   -> /dev/null, with getty and a few mounts): no logind ⇒ no user session, no user@UID, no session bus, no desktop — the
#   browser step of 17-t10 failed with «I do NOT have the session bus» for 1.5 (and would have for 1.0). A real Alma machine
#   has logind: unmasked here, so that the box is a customer's machine and not a container image's choice.
RUN systemctl unmask systemd-logind.service
COPY common.sh /usr/local/sbin/t17-comune
RUN sh /usr/local/sbin/t17-comune "$SSH_PORT" sshd.service
COPY chiave-banco.pub /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/sbin/init"]
