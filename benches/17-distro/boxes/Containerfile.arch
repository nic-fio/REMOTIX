# Containerfile.arch — phase 17: the "customer" box of Arch with the desktop DESKTOP (gnome, plasma, xfce4 +
# xfce4-goodies, lxqt + breeze-icons: the same as 17-vm.sh dress, WITHOUT enabling the display
# manager: the box boots into multi-user). The rest as in Containerfile.debian13.
FROM docker.io/archlinux/archlinux:latest
ARG DESKTOP
ARG SSH_PORT=8600
RUN case "$DESKTOP" in gnome|kde|xfce|lxqt) ;; *) echo "DESKTOP=\"$DESKTOP\": gnome|kde|xfce|lxqt" >&2; exit 2 ;; esac
# the official image strips man pages and the like (NoExtract): it is left as it is
RUN pacman -Syu --noconfirm systemd dbus sudo procps-ng iproute2 ca-certificates curl openssh \
    && pacman -Scc --noconfirm
RUN case "$DESKTOP" in gnome) P="gnome" ;; kde) P="plasma" ;; xfce) P="xfce4 xfce4-goodies" ;; lxqt) P="lxqt breeze-icons" ;; esac \
    && pacman -S --noconfirm --needed $P && pacman -Scc --noconfirm
COPY common.sh /usr/local/sbin/t17-comune
RUN sh /usr/local/sbin/t17-comune "$SSH_PORT" sshd.service
COPY chiave-banco.pub /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/lib/systemd/systemd"]
