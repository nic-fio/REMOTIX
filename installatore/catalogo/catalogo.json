      "decisione": "D5",
      "comandi": {
        "fedora": "sudo dnf install https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm && sudo dnf install libavcodec-freeworld",
        "rhel": "sudo dnf install https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-$(rpm -E %rhel).noarch.rpm && sudo dnf install libavcodec-freeworld   # DOPO EPEL, o libavcodec-free va in conflitto (§11.1)"
      }
    },
    "packman": {
      "nome": "Packman",
      "decisione": "D5",
      "comandi": {
        "tumbleweed": "sudo zypper ar -cfp 90 https://ftp.gwdg.de/pub/linux/misc/packman/suse/openSUSE_Tumbleweed/ packman && sudo zypper dup --from packman --allow-vendor-change",
        "leap16": "sudo zypper ar -cfp 90 https://ftp.gwdg.de/pub/linux/misc/packman/suse/openSUSE_Leap_16.0/ packman && sudo zypper dup --from packman --allow-vendor-change   # [?] percorso da confermare"
      }
    },
    "epel": {
      "nome": "EPEL (con CRB)",
      "decisione": "",
      "comandi": {
        "rhel": "sudo dnf install epel-release && sudo dnf config-manager --set-enabled crb"
      }
    }
  },
  "installa": {
    "debian": "sudo apt install",
    "fedora": "sudo dnf install",
    "arch": "sudo pacman -S",
    "suse": "sudo zypper install"
