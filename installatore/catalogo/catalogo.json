    {
      "component": "LXQt",
      "minimum": "2.0 (Wayland)",
      "reason_text": "the session under labwc"
    },
    {
      "component": "labwc / wlroots",
      "minimum": "labwc 0.8 with -m/-C/-S; wlroots 0.18",
      "reason_text": "wlroots.c, sessione.c"
    },
    {
      "component": "a scalable font",
      "minimum": "any (DejaVu, Noto, Droid…)",
      "reason_text": "without one, labwc dies (labwc #2525)"
    },
    {
      "component": "VA-API",
      "minimum": "a driver with H.264 encoding (iHD Intel, radeonsi AMD with the codecs); not the proprietary NVIDIA one (it goes through Vulkan Video)",
      "reason_text": "encoding on the graphics card: without a capable card REMOTIX is not installed (DECISIONS §10.27)"
    },
    {
      "component": "Vulkan Video",
      "minimum": "loader 1.3.274; a driver with VK_KHR_video_encode_h264/h265: RADV from a Mesa built with the codecs (AMD), the proprietary NVIDIA driver with its ICD [?] not tested",
      "reason_text": "the path tried first (phase 19, DECISIONS §10.27); without it, the card goes through VA-API"
    }
  ],
