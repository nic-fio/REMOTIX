# Containerfile — Debian 13 (trixie) test box with ONE desktop, built as a user would set the machine up:
#   podman build --build-arg DESKTOP=xfce|lxqt|gnome|kde ...
# systemd is the init, sshd is on, two ordinary test users exist, and there is NOTHING of REMOTIX inside:
# the .deb is installed later with apt (box.sh install).
FROM docker.io/library/debian:trixie
ARG DESKTOP
ARG SSH_PORT=2211
ENV DEBIAN_FRONTEND=noninteractive
RUN case "$DESKTOP" in gnome|kde|xfce|lxqt) ;; *) echo "DESKTOP=\"$DESKTOP\": gnome|kde|xfce|lxqt" >&2; exit 2 ;; esac
RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus dbus-user-session libpam-systemd \
        sudo procps iproute2 ca-certificates curl openssh-server \
    && rm -rf /var/lib/apt/lists/*
# The desktop as a Debian user installs it (task package, with recommends). The display manager is stated first,
# and registered after (a container build has no postinst effect on systemd).
COPY set-dm.sh /usr/local/sbin/box-set-dm
RUN case "$DESKTOP" in gnome) DM=gdm3 ;; kde|lxqt) DM=sddm ;; xfce) DM=lightdm ;; esac \
    && echo "$DM shared/default-x-display-manager select $DM" | debconf-set-selections \
    && apt-get update && apt-get install -y -q "task-$DESKTOP-desktop" \
    && sh /usr/local/sbin/box-set-dm "$DM" \
    && rm -rf /var/lib/apt/lists/*
# Small tools for tests (python3-gi + gir1.2-gtk-4.0: GTK4 test window; libglib2.0-bin: gdbus/gsettings);
# pcmanfm-qt is LXQt's file manager (wallpaper and icons).
RUN apt-get update && apt-get install -y -q openssh-client python3 python3-gi gir1.2-gtk-4.0 libglib2.0-bin gawk openssl wl-clipboard \
    && { [ "$DESKTOP" != lxqt ] || apt-get install -y -q pcmanfm-qt; } \
    && rm -rf /var/lib/apt/lists/*
# KDE: hide the Plasma "Welcome Center" over a new user's first login. For every /etc/xdg/autostart file that says
# "welcome", an entry of the same name with Hidden=true (XDG autostart spec) in /etc/skel, plus plasma-welcomerc with
# a far-ahead "last seen" version. The test users are created below with `useradd -m`, so they get it.
RUN if [ "$DESKTOP" = kde ]; then mkdir -p /etc/skel/.config/autostart \
    && for f in $(grep -il welcome /etc/xdg/autostart/*.desktop 2>/dev/null); do echo "box: welcome autostart hidden for new users: $f"; \
        printf '[Desktop Entry]\nType=Application\nName=Welcome\nHidden=true\n' > "/etc/skel/.config/autostart/$(basename "$f")"; done \
    && printf '[General]\nLastSeenVersion=99.0.0\n' > /etc/skel/.config/plasma-welcomerc; fi
COPY common.sh /usr/local/sbin/box-common
RUN sh /usr/local/sbin/box-common "$SSH_PORT" ssh.service
# Two ordinary test users (no sudo), same password. Created after the skeleton above.
RUN for u in prova prova2; do useradd -m -s /bin/bash "$u" && echo "$u:prova2026" | chpasswd; done
COPY box-key.pub /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys
# Identity check at build time: an image that is not Debian 13 with this desktop is not built.
COPY box-identity.sh /usr/local/sbin/box-identity
RUN sh /usr/local/sbin/box-identity debian 13 "$DESKTOP" -
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
