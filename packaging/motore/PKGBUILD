# PKGBUILD — il motore d'installazione di REMOTIX per Arch.
# Binario Go STATICO (installatore/costruisci.sh): qui si impacchetta soltanto; il catalogo sta
# dentro il binario (DECISIONI §10.21). Lo costruisce packaging/motore/pacchetti-motore.sh, chiamato
# dal comando di rilascio (pkgver/pkgrel dall'ambiente).
# ⛔ DECISIONI §10.12: non accende niente. D14 (§10.23): niente timer, REMOTIX si aggiorna col sistema.

# Maintainer: nicfio <nicfio@gmail.com>
pkgname=remotix-install
pkgver=${RX_VERSIONE:-0.1.0}
pkgrel=${RX_RILASCIO:-1}
pkgdesc='Il motore d installazione di REMOTIX (installa, verifica, certifica, disinstalla)'
arch=('x86_64')
url='https://github.com/nic-fio/REMOTIX'
license=('LicenseRef-REMOTIX')
depends=(systemd pacman)
options=('!strip' '!debug')
install=remotix-install.install
source=(remotix-install README)
sha256sums=('SKIP' 'SKIP')

package() {
	install -Dm755 remotix-install "$pkgdir/usr/bin/remotix-install"
	install -Dm644 README          "$pkgdir/usr/share/remotix-install/README"
}
