# remotix-aggiorna.service — il controllo quotidiano degli aggiornamenti di REMOTIX
# (DECISIONI.md §10.10, fasi/17-l-installatore.md T8).
#
# ⛔ Lo lancia SOLO remotix-aggiorna.timer, che il pacchetto porta SPENTO: lo accende il motore
#    all'installazione, col consenso (DECISIONI §10.12: il pacchetto porta pezzi inerti).
# ⭐ Che cosa fa: il motore scarica e VERIFICA il catalogo firmato del canale (catena A), rinfresca
#    il SOLO archivio di REMOTIX (il gestore di pacchetti ne verifica la firma, catena B) e, come dice
#    /etc/remotix/aggiornamenti.conf (predefinito: la proposta di D14 — manutenzione sì, versione
#    annuale su scelta), fa aggiornare i pacchetti di REMOTIX al GESTORE DI PACCHETTI. Il servizio
#    riparte senza chiudere i desktop (T7). Ogni aggiornamento è un'operazione del motore, col suo
#    registro e il suo certificato in /var/lib/remotix/operazioni/.
[Unit]
Description=REMOTIX: controllo degli aggiornamenti (archivio firmato e catalogo)
Documentation=file:///usr/share/remotix-install/LEGGIMI
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/remotix-install aggiorna --dal-timer
Nice=10
IOSchedulingClass=idle
