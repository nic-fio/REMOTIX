<?xml version="1.0" encoding="utf-8"?>
<!-- remotix: the firewalld service, DEFINED and not opened (fasi/17 §6.4, D6).
     The page goes over TCP, QUIC over UDP, on the same port. -->
<service>
  <short>REMOTIX</short>
  <description>REMOTIX, the desktop in the browser: the page (TCP) and the QUIC stream (UDP).</description>
  <port protocol="tcp" port="7447"/>
  <port protocol="udp" port="7447"/>
</service>
