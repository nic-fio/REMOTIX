# remotix.install — the Arch package scripts (phases/17 §6.4, §6.6.4).
#
# ⛔ DECISIONS.md §10.12 — THE INSTALLER IS THE ONLY WAY.  The package ships
#    the pieces INERT and mounts nothing: it does not enable the service (on Arch the
#    preset is already «disable *»), does NOT add anyone to the GPU groups,
#    does not touch the firewall, and leaves the three belts OFF in
#    /usr/share/remotix/belts/.  All of this is done by the engine, with consent,
#    and written in ITS log (R40).
#
# ⚠ The PRODUCT still enrols by itself whoever arrives at the first connection
#   (`child.c`, enroll_in_card_groups, DECISIONS.md §7.21), and
#   writes it only in the session log: with §10.12 that enrolment must be
#   moved into the engine's log, or uninstallation does not know about it.

# ⭐ DECISIONS-11.md §11.50, PHASE F — the system user remotix and the network side's directories, BEFORE anything can
#    start the new server.  pacman's sysusers and tmpfiles hooks are PostTransaction: they run AFTER post_upgrade's
#    try-restart, too late — so the scripts call both themselves, then the 1.0 → 1.5 move of certificates/ and ban into
#    /var/lib/remotix/net (remotix-net-move).  ⛔ INERT unless the package carries remotix-net-move (only a
#    REMOTIX_SPLIT=1 build installs it).  A failure is said, never makes pacman fail.
network_side() {
	[ -x /usr/lib/remotix/remotix-net-move ] || return 0
	systemd-sysusers remotix.conf || echo "remotix: ⚠ systemd-sysusers remotix.conf failed" >&2
	/usr/lib/remotix/remotix-net-move || echo "remotix: ⚠ the move into /var/lib/remotix/net is incomplete" >&2
	systemd-tmpfiles --create remotix.conf 2>/dev/null
	# the unit changed its paths: daemon-reload first (pacman's own reload hook is PostTransaction too)
	systemctl daemon-reload 2>/dev/null
	return 0
}

post_install() {
	network_side
	cat <<'FINE'
:: REMOTIX: pieces installed, OFF.  The package alone switches on
   nothing: the service, the GPU groups, the three belts and the firewall
   are set up by the REMOTIX installer (DECISIONS.md §10.12).
FINE
}

post_upgrade() {
	network_side
	# ⭐ T2 (§5.2), T7: stopping the service does NOT close the desktops, and the new
	#    service finds them again.  An old server with the new binary on disk
	#    would spawn children with the new binary: if it was ON it restarts
	#    (try-restart: if it was off it stays off).  REMOTIX updates with the
	#    system, pacman -Syu (DECISIONI §10.23).
	systemctl try-restart remotix.service 2>/dev/null
	# the engine records the versions and says whether the installation is still
	# certified (§10.12 point 4); it never makes pacman fail
	[ -x /usr/bin/remotix-install ] && /usr/bin/remotix-install post-upgrade
	return 0
}

# ⭐ PHASE F (§11.50): on a REMOVAL the network side's files go back to the 1.0 paths (`remotix-net-move --back`).  INERT
#    unless the package carries remotix-net-move.
# ⚠ A DOWNGRADE cannot be done from here: pacman runs the NEW package's scripts (the older one's pre_upgrade), never this
#    one's.  Before `pacman -U <older package>` the administrator runs `/usr/lib/remotix/remotix-net-move --back`
#    (it stops the service; the desktops stay) — the same command, idempotent.
# ⭐ The marker /run/remotix/back-incomplete: --back failed, OR exited 0 but left certificates/ or a ban in net/ (a
#    hard-linked ban, both copies present — it says so and leaves them).  post_remove then KEEPS net/ instead of deleting
#    the very files --back refused to move.  A --back that succeeds removes the marker.  /run is a tmpfs: the marker
#    lives for the transaction, which is all post_remove needs.
net_back() {
	local bad= f
	rm -f /run/remotix/back-incomplete
	[ -x /usr/lib/remotix/remotix-net-move ] || return 0
	/usr/lib/remotix/remotix-net-move --back || bad=1
	for f in certificates ban ban.new; do
		{ [ -e "/var/lib/remotix/net/$f" ] || [ -L "/var/lib/remotix/net/$f" ]; } && bad=1
	done
	if [ -n "$bad" ]; then
		echo "remotix: ⚠ the move of /var/lib/remotix/net back is incomplete" >&2
		install -d -m 0755 /run/remotix 2>/dev/null && : > /run/remotix/back-incomplete
	fi
	return 0
}

# ⭐ R-1 of the page audit (25 Oct 2026): the card grants (ACL on /dev/dri/renderD*, DECISIONS-11 §11.4) are taken back with the
#    service stopped and BEFORE post_remove deletes the record and the binary goes.  A failure is said and leaves the marker
#    /run/remotix/render-grants-kept: post_remove then keeps the record.  Never fails the transaction.
drop_render_grants() {
	rm -f /run/remotix/render-grants-kept
	[ -x /usr/lib/remotix/remotix ] || return 0
	if ! /usr/lib/remotix/remotix --drop-render-grants; then
		echo "remotix: ⚠ the card grants (ACL on /dev/dri/renderD*) could not all be taken back: they vanish at the next boot" >&2
		install -d -m 0755 /run/remotix 2>/dev/null && : > /run/remotix/render-grants-kept
	fi
	return 0
}

pre_remove() {
	net_back
	# A remote-access server does not stay listening with its binary deleted,
	# nor does an enable link stay behind for a unit that disappears.
	systemctl --no-reload disable --now remotix.service 2>/dev/null
	drop_render_grants
	return 0
}

post_remove() {
	# ⭐ R6: the state the SERVICE created by itself (certificates, ban) goes
	#    away with the package.  /etc/remotix/denied-users and /etc/pam.d/remotix are
	#    handled by pacman (backup=: with -n they vanish, without they stay as .pacsave).
	#    ⛔ Not net/ when --back left something there (the marker of net_back()): those files are the administrator's.
	if [ -e /run/remotix/back-incomplete ]; then
		echo "remotix: net/ kept: --back was incomplete (/var/lib/remotix/net)" >&2
	else
		rm -rf /var/lib/remotix/net
	fi
	rm -rf /var/lib/remotix/certificates
	rm -f /var/lib/remotix/ban /var/lib/remotix/ban.new
	if [ -e /run/remotix/render-grants-kept ]; then
		echo "remotix: render-grants kept: the card grants could not all be taken back" >&2
	else
		rm -f /var/lib/remotix/render-grants /var/lib/remotix/render-grants.new
	fi
	rmdir /var/lib/remotix 2>/dev/null
	systemctl daemon-reload 2>/dev/null
	return 0
}
