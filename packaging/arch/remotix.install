# remotix.install — the Arch package scripts (phases/17 §6.4, §6.6.4).
#
# ⛔ DECISIONS.md §10.12 — THE INSTALLER IS THE ONLY WAY.  The package ships
#    the pieces INERT and mounts nothing: it does not enable the service (on Arch the
#    preset is already «disable *»), does NOT add anyone to the GPU groups,
#    does not touch the firewall, and leaves the three belts OFF in
#    /usr/share/remotix/belts/.  All of this is done by the engine, with consent,
#    and written in ITS log (R40).
#
# ⚠ The PRODUCT still enrols by itself whoever arrives at the first connection
#   (`child.c`, enroll_in_card_groups, DECISIONS.md §7.21), and
#   writes it only in the session log: with §10.12 that enrolment must be
#   moved into the engine's log, or uninstallation does not know about it.

post_install() {
	cat <<'FINE'
:: REMOTIX: pieces installed, OFF.  The package alone switches on
   nothing: the service, the GPU groups, the three belts and the firewall
   are set up by the REMOTIX installer (DECISIONS.md §10.12).
FINE
}

post_upgrade() {
	# ⭐ T2 (§5.2), T7: stopping the service does NOT close the desktops, and the new
	#    service finds them again.  An old server with the new binary on disk
	#    would spawn children with the new binary: if it was ON it restarts
	#    (try-restart: if it was off it stays off).  REMOTIX updates with the
	#    system, pacman -Syu (DECISIONI §10.23).
	systemctl try-restart remotix.service 2>/dev/null
	# the engine records the versions and says whether the installation is still
	# certified (§10.12 point 4); it never makes pacman fail
	[ -x /usr/bin/remotix-install ] && /usr/bin/remotix-install post-upgrade
	return 0
}

pre_remove() {
	# A remote-access server does not stay listening with its binary deleted,
	# nor does an enable link stay behind for a unit that disappears.
	systemctl --no-reload disable --now remotix.service 2>/dev/null
	return 0
}

post_remove() {
	# ⭐ R6: the state the SERVICE created by itself (certificates, ban) goes
	#    away with the package.  /etc/remotix/denied-users and /etc/pam.d/remotix are
	#    handled by pacman (backup=: with -n they vanish, without they stay as .pacsave).
	rm -rf /var/lib/remotix/certificates
	rm -f /var/lib/remotix/ban /var/lib/remotix/ban.new /var/lib/remotix/render-grants /var/lib/remotix/render-grants.new
	rmdir /var/lib/remotix 2>/dev/null
	systemctl daemon-reload 2>/dev/null
	return 0
}
