# remotix.service — il server REMOTIX, famiglia .rpm (`fasi/17-l-installatore.md` §6.4).
# Uguale nella sostanza a `packaging/debian/remotix.service` (linea B).
#
# ⭐ Da ROOT, e fuori da ogni sessione utente: PAM deve poter verificare la
#    parola di CHIUNQUE, e il server fa scendere ogni figlio all'uid del suo
#    utente (`figlio.c`).  Niente `User=`, niente `ProtectSystem`: apre
#    sessioni logind, scrive nelle case degli utenti, tocca /dev/dri.
# ⭐ Certificato: se manca in /var/lib/remotix/certificati lo genera all'avvio
#    (`certificati.c:302`); uno dell'amministratore (senza la marca «.nostro»)
#    si usa com'e'.
# ⭐ Il nome nel certificato e' il nome della macchina (%H).  Chi entra con un
#    indirizzo IP lo dichiara in /etc/remotix/remotix.conf.d/<qualcosa>.conf:
#        REMOTIX_OPZIONI=--nome 192.168.1.10
#    (l'ultimo --nome vince).  ⚠ Formato PROVVISORIO, variabili d'ambiente: la
#    configurazione vera e' del motore (T4).
# ⭐ `KillMode=mixed`, `LimitRTPRIO`, `LimitNICE`: gli stessi dei banchi
#    (`src/riavvia-7700.sh`).  `[M]` T2 (§5.2): con `mixed` fermare il servizio
#    uccide padre, aiutante PAM e figlio, NON i desktop (il palco nasce con
#    `setsid --fork` fuori dall'unita').
# ⭐ `--journal`: le righe vanno al journal anche coi campi (priorita',
#    `REMOTIX_AREA`, `REMOTIX_INQUILINO`) e dal figlio, che sta nello scope della
#    sessione (`registro.h`: ⇒ `journalctl -t remotix`).
# ⛔ Nessuna opzione di banco (`--rilievo`, `--comando-socket`, `--audio-prova`,
#    `--parlantina`, `--sblocca`): R13.
# ⛔ `DECISIONI.md` §10.12: il pacchetto NON abilita e NON avvia questa unita'
#    (lo fa il motore), e nessuna guardia le impedisce di partire.
[Unit]
Description=REMOTIX, il desktop nel browser
After=network.target systemd-logind.service
Wants=network.target

[Service]
Type=simple
EnvironmentFile=/usr/share/remotix/remotix.conf
EnvironmentFile=-/etc/remotix/remotix.conf.d/*.conf
WorkingDirectory=/
# ⭐ T6 (SELinux): il programma si lancia DIRETTAMENTE, senza `/bin/sh -c`.  systemd
#    passa a `remotix_t` solo se esegue lui `remotix_exec_t` (init_t → remotix_t); una
#    shell in mezzo girerebbe in `unconfined_service_t` e il suo `exec` restava li'.
#    `${REMOTIX_PORTA}` e' una parola sola; `$REMOTIX_OPZIONI` senza graffe si divide
#    in parole, e vuota non ne da' nessuna (systemd.service, «Command lines»).
ExecStart=/usr/libexec/remotix/remotix --indirizzo 0.0.0.0 --nome %H --porta ${REMOTIX_PORTA} --certificati /var/lib/remotix/certificati --pagina /usr/share/remotix/pagina.html --ban-file /var/lib/remotix/ban --journal $REMOTIX_OPZIONI
KillMode=mixed
LimitRTPRIO=20
LimitNICE=-11
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
