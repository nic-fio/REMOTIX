<?xml version="1.0" encoding="utf-8"?>
<!-- remotix: il servizio firewalld di REMOTIX, la pagina (TCP) e QUIC (UDP)
     sulla stessa porta.  DEFINITO, non aperto: il pacchetto non tocca le zone.
     L'apertura e' del motore d'installazione, col consenso (D6).
     Con una porta diversa dalla 7447 il motore apre quella, non questo servizio.
     Attenzione: in un commento XML non ci possono stare due trattini di fila
     (le opzioni di firewall-cmd): firewalld scarterebbe il file intero.
     [M] 29 set 2026, Fedora 44: "not well-formed (invalid token)". -->
<service>
  <short>REMOTIX</short>
  <description>REMOTIX: il desktop di questa macchina nel browser (HTTPS e QUIC/WebTransport).</description>
  <port protocol="tcp" port="7447"/>
  <port protocol="udp" port="7447"/>
</service>
