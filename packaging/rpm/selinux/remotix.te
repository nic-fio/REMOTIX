policy_module(remotix, 1.0.0)

# remotix.te — the REMOTIX SELinux module (phase 17, T6; `fasi/17-l-installatore.md` §11.1 B, R19).
#
# ⭐ Why it exists.  `DECISIONI.md` §10.18 (D3): the REMOTIX PAM file is the sshd stack, with
#    `pam_selinux close/open`.  `pam_selinux open` requires the next `execve` to transition to the
#    user's context (`unconfined_t` for a normal user) — and it is the REMOTIX child that does it, when it
#    relaunches itself as the user (`figlio.c`, `execve` of itself).  In the context of an arbitrary
#    service (`unconfined_service_t`) that transition is forbidden: `[M]` T1c, 29 Sep, Fedora and Alma:
#    `{ transition } unconfined_service_t → unconfined_t`, the child exits with 37 and the desktop is not born.
#    ⇒ Like Cockpit (`selinux/cockpit.te`: `cockpit_session_t`), REMOTIX has a domain of ITS OWN, which is
#    a «login program» like sshd and login (`auth_login_pgm_domain`) and which can transition to the
#    user's context (`userdom_spec_domtrans_all_users`, `unconfined_domtrans`).
#
# ⭐ The types:
#    remotix_t            the service (the parent, the PAM helper, the child up to its `execve`)
#    remotix_exec_t       /usr/libexec/remotix/remotix
#    remotix_port_t       port 7447, TCP (the page) and UDP (QUIC): `remotix_porta.cil`
#    remotix_var_lib_t    /var/lib/remotix (certificates, bans, engine log)
#    remotix_var_run_t    /run/remotix
#
# ⚠ The rules are the MEASURED ones (`[M]` on the VMs, the domain first in «permissive» and every denial
#   read with `ausearch -m avc`): a rule with no measurement behind it is not here.  Where a measurement
#   does not exist yet (a rare code path), the denial shows in the audit log and the
#   cure is `semanage permissive -a remotix_t` until the rule makes it in here.
#
# Built with `make -f /usr/share/selinux/devel/Makefile remotix.pp` (the spec does it, in the
# container of each target: the interfaces are those of THAT distribution's policy).

########################################
#
# The declarations
#

type remotix_t;
type remotix_exec_t;
# ⭐ like sshd (`init_ranged_daemon_domain(sshd_t, sshd_exec_t, s0 - mcs_systemhigh)`): the service
#    has all the categories, and `pam_selinux` gives the user their full level
#    (unconfined_u:unconfined_r:unconfined_t:s0-s0:c0.c1023, as for whoever logs in with ssh).  `[M]` with
#    `init_daemon_domain` the stage was born «s0» only.
# ⚠ Both lines: in Fedora `init_ranged_daemon_domain` NO LONGER calls init_daemon_domain
#   (it is commented out in the interface), and on its own it leaves systemd without permission to run the
#   program (`[M]` `{ getattr } init_t → remotix_exec_t`, 203/EXEC).
init_daemon_domain(remotix_t, remotix_exec_t)
init_ranged_daemon_domain(remotix_t, remotix_exec_t, s0 - mcs_systemhigh)

type remotix_port_t;
corenet_port(remotix_port_t)

type remotix_var_lib_t;
files_type(remotix_var_lib_t)

type remotix_var_run_t;
files_pid_file(remotix_var_run_t)

########################################
#
# The service
#

# ── the root privileges the service uses: dropping to the user's uid (setuid, setgid, the
#    groups), reading and changing the user files the child prepares, the stage limits
allow remotix_t self:capability { chown dac_override dac_read_search fowner fsetid kill setgid setuid sys_nice sys_resource };
allow remotix_t self:process { setexec setrlimit setsched signal_perms getsched };
allow remotix_t self:fifo_file rw_fifo_file_perms;
allow remotix_t self:unix_stream_socket { create_stream_socket_perms connectto };
allow remotix_t self:unix_dgram_socket create_socket_perms;
allow remotix_t self:netlink_kobject_uevent_socket create_socket_perms;

# ── the network: the page (TCP) and QUIC/WebTransport (UDP) on the REMOTIX port
allow remotix_t self:tcp_socket create_stream_socket_perms;
allow remotix_t self:udp_socket create_socket_perms;
allow remotix_t remotix_port_t:tcp_socket name_bind;
allow remotix_t remotix_port_t:udp_socket name_bind;
corenet_tcp_bind_generic_node(remotix_t)
corenet_udp_bind_generic_node(remotix_t)
corenet_tcp_sendrecv_generic_if(remotix_t)
corenet_udp_sendrecv_generic_if(remotix_t)

# ── its files
manage_dirs_pattern(remotix_t, remotix_var_lib_t, remotix_var_lib_t)
manage_files_pattern(remotix_t, remotix_var_lib_t, remotix_var_lib_t)
files_var_lib_filetrans(remotix_t, remotix_var_lib_t, dir)

manage_dirs_pattern(remotix_t, remotix_var_run_t, remotix_var_run_t)
manage_files_pattern(remotix_t, remotix_var_run_t, remotix_var_run_t)
manage_sock_files_pattern(remotix_t, remotix_var_run_t, remotix_var_run_t)
files_pid_filetrans(remotix_t, remotix_var_run_t, dir)

# the child relaunches itself: `execve` of the same program (then the transition to the user, below)
can_exec(remotix_t, remotix_exec_t)

# ── the GPU: /dev/dri (the node groups, the buffer test before labwc)
dev_rw_dri(remotix_t)
dev_read_sysfs(remotix_t)
dev_read_urand(remotix_t)
dev_read_rand(remotix_t)

# ── the system: /proc, /etc, the libraries, the certificates, the journal
kernel_read_system_state(remotix_t)
kernel_read_network_state(remotix_t)
kernel_read_kernel_sysctls(remotix_t)
files_read_etc_files(remotix_t)
files_read_usr_files(remotix_t)
files_search_var_lib(remotix_t)
fs_getattr_all_fs(remotix_t)
miscfiles_read_localization(remotix_t)
miscfiles_read_generic_certs(remotix_t)
logging_send_syslog_msg(remotix_t)
corecmd_exec_bin(remotix_t)
corecmd_exec_shell(remotix_t)
init_read_state(remotix_t)

########################################
#
# The login: PAM, logind, the transition to the user — like sshd
#

# the whole PAM stack, pam_selinux included (the same interface as sshd, login and cockpit-session)
auth_login_pgm_domain(remotix_t)
auth_use_nsswitch(remotix_t)
auth_read_shadow(remotix_t)
auth_domtrans_chk_passwd(remotix_t)
auth_write_login_records(remotix_t)

# `pam_systemd` opens the logind session (system D-Bus)
dbus_system_bus_client(remotix_t)
optional_policy(`
	systemd_dbus_chat_logind(remotix_t)
')

# ⭐ the transition to the user's context at the child's `execve`, without AT_SECURE (the child
#    builds the environment itself, `figlio.c` point 5): like `cockpit_session_t`
userdom_spec_domtrans_all_users(remotix_t)
userdom_noatsecure_login_userdomain(remotix_t)
# ⭐ the child relaunches itself AS THE USER by executing itself: the program is the entry point of
#    the user's domain.  `[M]` 30 Sep, fedora44-gnome-iso: `{ entrypoint } unconfined_t →
#    remotix_exec_t`, the child exits with 37.  (sshd and cockpit do not need it: they run a
#    shell or `cockpit-bridge`, files the user domains can already execute.)
gen_require(`
	attribute userdomain;
')
allow userdomain remotix_exec_t:file { entrypoint execute getattr map open read };

# ⭐ the parent closes the stage it gave birth to (abandonment, restart with a live desktop): signals
#    to the user's domain.  `[M]` fedora44-gnome-iso, domain in permissive and dontaudit off:
#    `{ signal } remotix_t → unconfined_t`.  Like cockpit (`userdom_signal_all_users`).
userdom_signal_all_users(remotix_t)
userdom_kill_all_users(remotix_t)

# ⚠ Two denials that take nothing away, and that are SILENCED (`[M]` alma10-gnome-iso and fedora44-gnome-iso,
#   permissive and dontaudit off, a whole session with a service restart with a live desktop):
#   · `net_admin`: sd-journal and sd-bus try SO_SNDBUFFORCE on their sockets and, without it, keep the
#     default buffer — the same denial the policy silences for systemd services;
#   · `cap_userns sys_ptrace`: finding the stages again (`ritrovo.c`) walks /proc of ALL processes, and
#     those inside a user namespace (bwrap, flatpak, glycin) are not ours: skipping them is right.
dontaudit remotix_t self:capability net_admin;
dontaudit remotix_t self:cap_userns sys_ptrace;
optional_policy(`
	unconfined_domtrans(remotix_t)
')
