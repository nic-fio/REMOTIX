#!/bin/sh
# remotix-net-move — the 1.0 → 1.5 move of the network side's files
# (DECISIONS.md §11.50), run by the package's scripts BEFORE the service restarts:
#   Debian postinst, rpm %post, Arch post_install/post_upgrade.
#
# 1.0 kept certificates/ (the .ours marks and maybe the administrator's own
# page.pem/page.key) and ban in /var/lib/remotix, owned by root; 1.0 had no
# quic-secret — the 1.4.99 test builds before the split put one in
# certificates/ too.  1.5 reads them from /var/lib/remotix/net, as the user remotix:
#   · a ban file remotix cannot read STOPS the server (main.c, invariant I7);
#   · a root-owned quic-secret (a test build's) would be silently replaced by a
#     per-run secret.
# ⇒ They are MOVED (never copied, never deleted) and given to remotix.
# ⭐ Idempotent: with nothing to move, nothing changes (owners and modes are
#    tmpfiles' job, run right after by every family's script).
# ⛔ An administrator's page.pem/page.key (no page.ours mark) moves with the
#    rest, and the journal says so: it is never regenerated.
# ⭐ `remotix-net-move --back` is the reverse (net/ → the 1.0 paths, owned by root again, the empty net/ removed and /var/lib/remotix 0700 again), for a DOWNGRADE to 1.0 or a
#    removal, called by the prerm / %preun / pre_remove of the split package (never on an upgrade; Arch calls it only from
#    pre_remove — on a DOWNGRADE the administrator runs it by hand, as the remotix.install comment says): a 1.0
#    would otherwise not find its ban and certificates, and make new ones (ban reset, another fingerprint).  Same
#    safety as the forward move: mv -T, nothing followed, idempotent, and it RESUMES — a run interrupted between the
#    mv and the chown finds the files already back and only gives them to root.  It stops the service first (the old
#    network side writes in net/); the desktops stay (T2).  ⭐ After a downgrade the service STAYS STOPPED: the marker
#    /run/remotix/was-running (written if the unit was active or activating) says whether it was running, so whoever
#    does the downgrade (or the installer engine, later) can start it again.  A hard-linked ban is left in net/, said.
# ⛔ The SAME file in packaging/{debian,rpm,arch}/remotix-net-move
#    (packaging/arch/build.sh checks they are byte-identical).
set -u
S=/var/lib/remotix
N=$S/net

say() {
	echo "remotix: $*"
	logger -t remotix-package -- "$*" 2>/dev/null || :
}

# ⭐ --back: see the header.  No user remotix needed (it may be gone).
if [ "${1:-}" = "--back" ]; then
	if [ -d /run/systemd/system ]; then
		# the marker first: was it running (active or activating)?  Stopping a stopped unit succeeds, so always stop.
		if systemctl is-active --quiet remotix.service 2>/dev/null || [ "$(systemctl is-active remotix.service 2>/dev/null)" = activating ]; then
			install -d -m 0755 -o root -g root /run/remotix && : > /run/remotix/was-running && chmod 0644 /run/remotix/was-running \
				|| say "⚠ could not write /run/remotix/was-running"
		fi
		say "stopping remotix.service (the desktops stay) before moving $N back: it stays stopped, see /run/remotix/was-running"
		systemctl stop remotix.service || { say "⛔ the service did not stop: nothing moved back"; exit 1; }
	fi
	if [ -L "$N" ] || { [ -e "$N" ] && [ ! -d "$N" ]; }; then
		say "⛔ $N is not a directory: nothing moved back"
		exit 1
	fi
	# Root's again.  By PATH and with -h (a link is changed itself, never followed), no -R: the directory first —
	# it now sits in $S (root's, 0755), so remotix can no longer change what is inside — then its entries that are
	# not links; a hard-linked file is refused and said (tmpfiles' rule too).
	own_back() {
		if [ -f "$1" ] && [ ! -L "$1" ]; then
			# a single regular file: only when nobody else holds a link to it
			[ "$(stat -c %h -- "$1")" = 1 ] || { say "⚠ $1 has more than one hard link: not given to root"; return 0; }
		fi
		chown -h root:root -- "$1" || return 1
		if [ -d "$1" ]; then
			find "$1" -mindepth 1 -maxdepth 1 ! -type l \( -type d -o -links 1 \) -exec chown -h root:root -- {} + || return 1
			if [ -n "$(find "$1" -mindepth 1 -maxdepth 1 -type f ! -links 1)" ]; then
				say "⚠ a hard-linked file in $1 was not given to root"
			fi
		fi
	}
	# certificates/ (a directory)
	if [ -d "$N/certificates" ] && [ ! -L "$N/certificates" ]; then
		# an empty directory left by rpm/dpkg is not «already there»
		if [ -d "$S/certificates" ] && [ ! -L "$S/certificates" ] && [ -z "$(ls -A "$S/certificates")" ]; then
			rmdir "$S/certificates" || exit 1
		fi
		if [ -e "$S/certificates" ] || [ -L "$S/certificates" ]; then
			say "⚠ both $S/certificates and $N/certificates exist: the one in net/ is left where it is, not merged"
		else
			# ⛔ -T: as in the forward move
			mv -T "$N/certificates" "$S/certificates" || exit 1
			say "moved $N/certificates to $S/certificates (1.5 → 1.0)"
		fi
	fi
	# the resume: the directory is in $S, nothing is left in net/ — whatever the cause (a run interrupted after the
	# mv), it is given to root.  A no-op when it is root's already.
	if [ -d "$S/certificates" ] && [ ! -L "$S/certificates" ] && [ ! -e "$N/certificates" ]; then
		own_back "$S/certificates" || { say "⛔ $S/certificates could not be given back to root"; exit 1; }
	fi
	for f in ban ban.new; do
		if [ -f "$N/$f" ] && [ ! -L "$N/$f" ]; then
			if [ -e "$S/$f" ] || [ -L "$S/$f" ]; then
				say "⚠ both $S/$f and $N/$f exist: the one in net/ is left where it is"
			elif [ "$(stat -c %h -- "$N/$f")" -gt 1 ]; then
				say "⚠ $N/$f has more than one hard link: it is left in net/, not moved"
			else
				mv -T "$N/$f" "$S/$f" || exit 1
				say "moved $N/$f to $S/$f (1.5 → 1.0)"
				if [ -L "$S/$f" ]; then
					rm -f -- "$S/$f"
					say "⚠ $S/$f was a symbolic link (planted in the race): removed"
				fi
			fi
		fi
		if [ -f "$S/$f" ] && [ ! -L "$S/$f" ] && [ ! -e "$N/$f" ]; then
			own_back "$S/$f" || { say "⛔ $S/$f could not be given back to root"; exit 1; }
		fi
	done
	# net/ itself is the 1.5 package's own: once it is empty it goes (rmdir: never recursive, never a link), so the tree is the
	# 1.0's again — an empty directory owned by remotix would stay for ever, nobody would remove it.  Not empty (a hard-linked
	# ban, a file the administrator put there): it stays, and was said above.
	if [ -d "$N" ] && [ ! -L "$N" ]; then
		rmdir "$N" 2>/dev/null && say "removed the empty $N"
	fi
	# and with net/ gone nobody needs to cross $S any more: it is 0700 again, as the 1.0's tmpfiles (`d /var/lib/remotix 0700 root root`)
	# and its rpm %dir say (the forward move made it 0755 so that remotix could reach net/).  By path, not through a link.
	if [ ! -e "$N" ] && [ ! -L "$N" ] && [ -d "$S" ] && [ ! -L "$S" ]; then
		chmod 0700 -- "$S" || say "⚠ could not make $S 0700 again"
	fi
	exit 0
fi

if ! getent passwd remotix >/dev/null; then
	say "⛔ the system user remotix is missing (systemd-sysusers remotix.conf): nothing moved"
	exit 1
fi
if [ -L "$N" ] || { [ -e "$N" ] && [ ! -d "$N" ]; }; then
	say "⛔ $N is not a directory: nothing moved"
	exit 1
fi
install -d -m 0755 -o root -g root "$S" || exit 1
install -d -m 0700 -o remotix -g remotix "$N" || exit 1

if [ -d "$S/certificates" ] && [ ! -L "$S/certificates" ]; then
	# ⚠ rpm lays down net/certificates (its %dir) BEFORE %post, empty: an empty target
	#   is not «already there» (`[M]` 16 Oct 2026, fedora44 1.0.0-1 → 1.4.99-7: the move was
	#   refused, and the old package's erase then deleted its %ghost page.key and page.pem).
	if [ -d "$N/certificates" ] && [ ! -L "$N/certificates" ] && [ -z "$(ls -A "$N/certificates")" ]; then
		rmdir "$N/certificates" || exit 1
	fi
	if [ -e "$N/certificates" ]; then
		say "⚠ both $S/certificates and $N/certificates exist: the old one is left where it is, not merged"
	else
		if [ -e "$S/certificates/page.pem" ] && [ ! -e "$S/certificates/page.ours" ]; then
			say "the administrator's own page.pem/page.key move to $N/certificates and are given to remotix"
		fi
		# ⛔ -T: a LINK to a directory that remotix creates between the check above and this mv is not followed (the
		#    directory would land INSIDE its target); mv -T fails on it instead (rename(2) onto a link: ENOTDIR).
		mv -T "$S/certificates" "$N/certificates" || exit 1
		say "moved $S/certificates to $N/certificates (1.0 → 1.5)"
	fi
fi
for f in ban ban.new; do
	if [ -f "$S/$f" ] && [ ! -L "$S/$f" ]; then
		if [ -e "$N/$f" ]; then
			say "⚠ both $S/$f and $N/$f exist: the old one is left where it is"
		else
			mv -T "$S/$f" "$N/$f" || exit 1
			say "moved $S/$f to $N/$f (1.0 → 1.5)"
		fi
	fi
done

# ⛔ Owners and modes are NOT set here (review 3, F1): on a 1.5 → 1.5.x upgrade
#    the OLD network side (uid remotix) still runs while this script runs, and
#    remotix owns $N — a `find … -exec chown -h/chmod` over it can be raced
#    (a directory swapped for a link to / between the walk and the exec ⇒
#    `chmod 0700 /`, a planted name ⇒ `chown remotix /etc/shadow`).  The
#    package's scripts run `systemd-tmpfiles --create remotix.conf` right after
#    this one: its `Z`/`z` lines walk by descriptor with O_NOFOLLOW and refuse
#    hard links, which is the safe road.

# ⛔ An administrator's certificate kept as LINKS (review 3, F2: /etc/letsencrypt/
#    live/<host>/… is the usual case) is read by remotix through the link: if
#    remotix cannot read the target, the network side does not start.
for f in page.pem page.key; do
	l="$N/certificates/$f"
	[ -L "$l" ] || continue
	t=$(readlink -f -- "$l" 2>/dev/null || echo "?")
	if command -v runuser >/dev/null 2>&1 && runuser -u remotix -- test -r "$l" 2>/dev/null; then
		say "⚠ $l is a link to $t: remotix can read it today — a renewal that changes the target's owner or mode will stop the network side"
	else
		say "⛔⛔ $l is a link to $t, which the user remotix CANNOT read: the network side will NOT start.  Fix: copy the files in (install -m 0600 -o remotix -g remotix \"$t\" \"$l.new\" && mv \"$l.new\" \"$l\" for page.pem and page.key), and on renewal do the same from a deploy hook (certbot: /etc/letsencrypt/renewal-hooks/deploy/), then systemctl try-restart remotix"
	fi
done
exit 0
