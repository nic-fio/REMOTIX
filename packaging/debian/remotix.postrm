#!/bin/sh
# remotix.postrm — dopo che i file sono stati tolti (fasi/17 §6.4).
#
# ⛔ DECISIONI §10.12: gruppi, cinture, firewall e accensione li monta il MOTORE
#    e li annota nel SUO registro; li disfa lui.  Il pacchetto non li tocca,
#    ne' all'installazione ne' qui.
#   remove   restano la configurazione (/etc/remotix, /etc/pam.d/remotix) e
#            /var/lib/remotix;
#   purge    via cio' che il PROGRAMMA ha creato da se' (certificati, ban) e
#            /run/remotix; /var/lib/remotix solo se resta vuota — quel che ci
#            lascia il motore (il suo registro) non e' del pacchetto.
set -e

case "$1" in
purge)
	rm -rf /var/lib/remotix/certificati /var/lib/remotix/ban /run/remotix
	rmdir /var/lib/remotix 2>/dev/null || true
	;;
remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;
*)
	echo "postrm chiamato con un argomento sconosciuto: $1" >&2
	exit 1
	;;
esac

#DEBHELPER#

exit 0
