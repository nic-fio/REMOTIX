#!/bin/sh
# remotix.postrm — after the files have been removed (phases/17 §6.4).
#
# ⛔ DECISIONI §10.12: groups, belts, firewall and switch-on are set up by the ENGINE,
#    which records them in ITS log; it undoes them.  The package does not touch them,
#    neither at installation nor here.
#   remove   the configuration (/etc/remotix, /etc/pam.d/remotix) and
#            /var/lib/remotix stay;
#   purge    removes what the PROGRAM created by itself (certificates, ban) and
#            /run/remotix; /var/lib/remotix only if it is left empty — what the
#            engine leaves there (its log) does not belong to the package.
set -e

case "$1" in
purge)
	rm -rf /var/lib/remotix/net /var/lib/remotix/certificates /var/lib/remotix/ban /var/lib/remotix/ban.new /var/lib/remotix/render-grants /var/lib/remotix/render-grants.new /run/remotix
	rmdir /var/lib/remotix 2>/dev/null || true
	;;
remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;
*)
	echo "postrm called with an unknown argument: $1" >&2
	exit 1
	;;
esac

# ⭐ 1.6 (AppArmor, NOT TRIED): the profile leaves the kernel when the package leaves.  Written to the
#    kernel's own remove file: the profile file may already be gone.  Never fails.
case "$1" in
remove|purge|disappear)
	if [ -w /sys/kernel/security/apparmor/.remove ]; then
		printf '%s' remotix_network > /sys/kernel/security/apparmor/.remove 2>/dev/null || true
	fi
	;;
esac

#DEBHELPER#

exit 0
