#!/bin/sh
# remotix.postinst — dopo che i file sono al loro posto (fasi/17 §6.4).
#
# ⛔ DECISIONI §10.12: il pacchetto non accende niente; il servizio, i gruppi,
#    le cinture e il firewall li monta il MOTORE, col consenso.
# ⭐ All'aggiornamento (apt upgrade: REMOTIX si aggiorna col sistema, DECISIONI
#    §10.23) la parte di debhelper qui sotto fa `try-restart`: il servizio
#    riparte SOLO se girava, e i desktop restano vivi (T2, §5.2) — il servizio
#    nuovo li ritrova (T7).  Poi il motore, se c'e', annota le versioni e dice
#    se l'installazione e' ancora certificata (§10.12 punto 4).  ⛔ Il motore
#    non fa mai fallire apt.
set -e

#DEBHELPER#

if [ "$1" = configure ] && [ -n "${2:-}" ] && [ -x /usr/bin/remotix-install ]; then
	/usr/bin/remotix-install aggiornato || true
fi

exit 0
