#!/bin/sh
# remotix.postinst — after the files are in place (fasi/17 §6.4).
#
# ⛔ DECISIONI §10.12: the package switches nothing on; the service, the groups,
#    the belts and the firewall are set up by the ENGINE, with consent.
# ⭐ On upgrade (apt upgrade: REMOTIX upgrades with the system, DECISIONI
#    §10.23) the debhelper part below does `try-restart`: the service
#    restarts ONLY if it was running, and the desktops stay alive (T2, §5.2) — the new
#    service finds them again (T7).  Then the engine, if present, records the versions and says
#    whether the installation is still certified (§10.12 point 4).  ⛔ The engine
#    never makes apt fail.
set -e

#DEBHELPER#

if [ "$1" = configure ] && [ -n "${2:-}" ] && [ -x /usr/bin/remotix-install ]; then
	/usr/bin/remotix-install post-upgrade || true
fi

exit 0
