#!/bin/sh
# remotix.postinst — after the files are in place (phases/17 §6.4).
#
# ⛔ DECISIONI §10.12: the package switches nothing on; the service and the
#    groups are set up by the ENGINE, with consent; the belts and the
#    firewall are the administrator's (DECISIONS §10.36: REMOTIX does not modify the system).
# ⭐ On upgrade (apt upgrade: REMOTIX upgrades with the system, DECISIONI
#    §10.23) the debhelper part below does `try-restart`: the service
#    restarts ONLY if it was running, and the desktops stay alive (T2, §5.2) — the new
#    service finds them again (T7).  Then the engine, if present, records the versions and says
#    whether the installation is still certified (§10.12 point 4).  ⛔ The engine
#    never makes apt fail.
set -e

# ⭐ DECISIONS-11.md §11.50 (PHASE F) — BEFORE the debhelper part below (whose try-restart starts the new server): the
#    system user remotix, then the 1.0 → 1.5 move of certificates/ and ban into /var/lib/remotix/net.
#    ⛔ INERT unless the package carries remotix-net-move (only a REMOTIX_SPLIT=1 build installs it).  A failure is
#    said, never makes apt fail.
if [ "$1" = configure ] && [ -x /usr/libexec/remotix/remotix-net-move ]; then
	systemd-sysusers remotix.conf || echo "remotix: ⚠ systemd-sysusers remotix.conf failed" >&2
	/usr/libexec/remotix/remotix-net-move || echo "remotix: ⚠ the move into /var/lib/remotix/net is incomplete" >&2
	systemd-tmpfiles --create remotix.conf || echo "remotix: ⚠ systemd-tmpfiles --create remotix.conf failed" >&2
fi

#DEBHELPER#

if [ "$1" = configure ] && [ -n "${2:-}" ] && [ -x /usr/bin/remotix-install ]; then
	/usr/bin/remotix-install post-upgrade || true
fi

exit 0
