#!/usr/bin/make -f
# debian/rules — il pacchetto .deb di REMOTIX (fasi/17-l-installatore.md §6.1-§6.4).
#
# ⚠ Si costruisce DENTRO il contenitore del bersaglio (src/costruzione/
#   Contenitore.debian13 / .ubuntu2604) con `src/costruzione/costruisci-deb.sh`:
#   ngtcp2 1.25.0 e nghttp3 1.18.0 statiche stanno li' (LIBRARY_PATH,
#   PKG_CONFIG_PATH), non nelle Build-Depends (D2 chiusa: DECISIONI §10.6).
# ⚠ packaging/debian/ diventa debian/ nella copia dell'albero: nel deposito
#   la cartella e' packaging/debian perche' accanto verranno rpm/ e arch/.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

# ⛔ Il Makefile ha `CFLAGS ?= -O2 -g -std=gnu11 <avvertimenti>`: con i CFLAGS di
#    dpkg-buildflags nell'ambiente quella riga non vale piu' e si perderebbe
#    -std=gnu11 (gcc 15 va a gnu23).  ⇒ Si passano qui, INSIEME a quelli di
#    dpkg (tempra, -ffile-prefix-map per la costruzione riproducibile, R23).
#    CPPFLAGS (-D_FORTIFY_SOURCE) in coda: la regola %.o del Makefile non li usa.
R_CFLAGS := $(CFLAGS) $(CPPFLAGS) -std=gnu11 -Wall -Wextra -Wno-unused-parameter

# ⭐ D8 (DECISIONI §10.20): su Ubuntu REMOTIX avvia la sessione di serie
#    (`ubuntu`), non la `gnome` di universe ⇒ la raccomandazione solo-Ubuntu di
#    gnome-session (${remotix:Recommends}) e' TOLTA: il pacchetto e' lo stesso
#    per le due distribuzioni.

B := debian/remotix

%:
	dh $@

override_dh_auto_clean:
	$(MAKE) -C src pulisci

override_dh_auto_configure:
	# niente da configurare: `make dipendenze` controlla le versioni minime
	$(MAKE) -C src dipendenze

override_dh_auto_build:
	# ⛔ R24: le statiche collegate sono della versione dichiarata in
	#    Static-Built-Using (control), come fa lo spec rpm: uno SBOM che nomina
	#    una versione diversa da quella nel binario mentirebbe.
	test "$$(pkg-config --modversion libngtcp2)" = 1.25.0
	test "$$(pkg-config --modversion libnghttp3)" = 1.18.0
	# ⛔ R13: il binario del pacchetto NON ha la funzione di banco accesa.
	grep -qx '#define BANCO_ACCESO 0' src/rcp.c || \
	  { echo "⛔ src/rcp.c: BANCO_ACCESO non e' 0 — non si impacchetta (R13)"; exit 1; }
	$(MAKE) -C src tutto CFLAGS="$(R_CFLAGS)" LDFLAGS="$(LDFLAGS)"

override_dh_auto_test:

override_dh_auto_install:
	install -D -m 0755 src/remotix             $(B)/usr/libexec/remotix/remotix
	install -D -m 0644 src/pagina.html         $(B)/usr/share/remotix/pagina.html
	install -D -m 0644 debian/remotix.conf     $(B)/usr/share/remotix/remotix.conf
	# R24 (T8): le versioni delle statiche COLLEGATE, lette da pkg-config nel
	#    contenitore che ha costruito il binario: le legge lo SBOM dell'archivio.
	printf '{"formato":"remotix-incorporate/1","ngtcp2":"%s","nghttp3":"%s","fonte":"pkg-config delle .a collegate"}\n' \
	  "$$(pkg-config --modversion libngtcp2)" "$$(pkg-config --modversion libnghttp3)" \
	  >$(B)/usr/share/remotix/incorporate.json
	install -d -m 0755                         $(B)/etc/remotix/remotix.conf.d
	# PAM di Debian/Ubuntu (common-*; fasi/17 §4.3) e chi non entra (root).
	# Tutti e due conffile: dpkg li tiene al remove e li toglie al purge.
	install -D -m 0644 src/remotix.pam         $(B)/etc/pam.d/remotix
	install -D -m 0644 debian/utenti-negati    $(B)/etc/remotix/utenti-negati
	# Il permesso di cattura di KWin.  ⛔ BYTE PER BYTE come lo scrive
	# kwin_scrivi_permesso() (kwin.c:606) col binario in /usr/libexec/remotix:
	# cosi' il programma lo trova uguale e non lo riscrive.  Il codice va
	# cambiato per non scriverlo piu' (solo verificarlo): annotato, fasi/17 §13.1.
	install -D -m 0644 debian/org.kde.remotix.desktop \
	  $(B)/usr/share/applications/org.kde.remotix.desktop
	# ⛔ DECISIONI §10.12 — il pacchetto porta solo PEZZI INERTI: le tre cinture
	#    di §4.7 stanno SPENTE in /usr/share/remotix/cinture/ (nessuno le legge
	#    li'); le mette in vigore il MOTORE, col consenso (D4), e le annota nel
	#    suo registro.
	install -D -m 0644 src/remotix-niente-spegnimento.rules \
	  $(B)/usr/share/remotix/cinture/50-remotix-niente-spegnimento.rules
	install -D -m 0644 src/remotix-tasti.conf \
	  $(B)/usr/share/remotix/cinture/remotix-tasti.conf
	install -D -m 0644 debian/remotix-niente-sospensione.conf \
	  $(B)/usr/share/remotix/cinture/remotix-niente-sospensione.conf

override_dh_installsystemd:
	# ⛔ DECISIONI §10.12: il pacchetto NON abilita e NON avvia il servizio: lo
	#    accende il motore a installazione confermata.  In aggiornamento lo
	#    riavvia (deb-systemd-invoke restart) SOLO se era gia' attivo o abilitato;
	#    non lo ferma prima: i desktop sopravvivono all'arresto (§5.2).
	dh_installsystemd --no-enable --no-start --restart-after-upgrade
