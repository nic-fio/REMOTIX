#!/usr/bin/make -f
# debian/rules — the REMOTIX .deb package (phases/17-the-installer.md §6.1-§6.4).
#
# ⚠ It is built INSIDE the target's container (src/build-targets/
#   Containerfile.debian13 / .ubuntu2604) with `src/build-targets/build-deb.sh`:
#   static ngtcp2 1.25.0 and nghttp3 1.18.0 live there (LIBRARY_PATH,
#   PKG_CONFIG_PATH), not in the Build-Depends (D2 closed: DECISIONI §10.6).
# ⚠ packaging/debian/ becomes debian/ in the copy of the tree: in the repository
#   the directory is packaging/debian because rpm/ and arch/ will sit next to it.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

# ⛔ The Makefile has `CFLAGS ?= -O2 -g -std=gnu11 <warnings>`: with dpkg-buildflags'
#    CFLAGS in the environment that line no longer applies and
#    -std=gnu11 would be lost (gcc 15 defaults to gnu23).  ⇒ They are passed here, TOGETHER with
#    dpkg's (hardening, -ffile-prefix-map for the reproducible build, R23).
#    CPPFLAGS (-D_FORTIFY_SOURCE) at the end: the Makefile's %.o rule does not use them.
R_CFLAGS := $(CFLAGS) $(CPPFLAGS) -std=gnu11 -Wall -Wextra -Wno-unused-parameter

# ⭐ D8 (DECISIONI §10.20): on Ubuntu REMOTIX starts the stock session
#    (`ubuntu`), not universe's `gnome` ⇒ the Ubuntu-only recommendation of
#    gnome-session (${remotix:Recommends}) is REMOVED: the package is the same
#    for both distributions.

B := debian/remotix

# ⭐ PIANO «Correzione B» — OUR labwc (/usr/lib/remotix/labwc: labwc + a patched, static wlroots,
#    packaging/labwc-ospite/) to host the nested KWin >= 6.5.  Built ONLY on Ubuntu 26.04 (KWin 6.6);
#    Debian 13 (KWin 6.3) and older Ubuntus keep the distribution's labwc, as today.
#    The criterion is the distribution that builds it, read where the package is built (a container
#    per target): Ubuntu (dpkg-vendor) at 26.04 or later (/etc/os-release VERSION_ID).  Not the
#    version of kwin: it is not installed in the build container.  REMOTIX_LABWC_OSPITE=0|1 in
#    the environment overrides it.  build-deb.sh puts the tarballs in labwc-ospite/sources and
#    adds the extra Build-Depends to control for ubuntu2604 only.
REMOTIX_LABWC_OSPITE ?= $(shell . /etc/os-release 2>/dev/null; if dpkg-vendor --is Ubuntu \
  && dpkg --compare-versions "$$VERSION_ID" ge 26.04; then echo 1; else echo 0; fi)

# ⭐ DECISIONS-11.md §11.50, PHASE F — the network side's user, directories, units and the 1.0 → 1.5 move.
#    ⭐ ON by default (decided 25 Oct 2026): `REMOTIX_SPLIT=0 dpkg-buildpackage …` (src/build-targets/build-deb.sh
#    passes it through) builds the single-process package instead.
REMOTIX_SPLIT ?= 1

%:
	dh $@

override_dh_auto_clean:
	$(MAKE) -C src clean
	rm -rf debian/labwc-build debian/labwc-root

override_dh_auto_configure:
	# nothing to configure: `make deps` checks the minimum versions
	$(MAKE) -C src deps

override_dh_auto_build:
	# ⛔ R24: the linked static libraries are the version declared in
	#    Static-Built-Using (control), as the rpm spec does: an SBOM naming
	#    a version other than the one in the binary would lie.
	test "$$(pkg-config --modversion libngtcp2)" = 1.25.0
	test "$$(pkg-config --modversion libnghttp3)" = 1.18.0
	# ⛔ R13: the package's binary does NOT have the bench feature switched on.
	grep -qx '#define BENCH_ON 0' src/rcp.c || \
	  { echo "⛔ src/rcp.c: BENCH_ON is not 0 — not packaging (R13)"; exit 1; }
ifeq ($(REMOTIX_LABWC_OSPITE),1)
	# our labwc, with the dpkg flags (hardening, -ffile-prefix-map) already in the environment
	# (DPKG_EXPORT_BUILDFLAGS); no libwlroots must remain in its dependencies
	JOBS=$(or $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS))),4) \
	  BUILD_DIR=$(CURDIR)/debian/labwc-build labwc-ospite/build.sh labwc-ospite/sources $(CURDIR)/debian/labwc-root
	# kwin.c execs OUR labwc at this exact path (build-time choice, not a switch)
	$(MAKE) -C src all CFLAGS="$(R_CFLAGS)" LDFLAGS="$(LDFLAGS)" LABWC=/usr/lib/remotix/labwc
else
	$(MAKE) -C src all CFLAGS="$(R_CFLAGS)" LDFLAGS="$(LDFLAGS)"
endif

override_dh_auto_test:

override_dh_auto_install:
	install -D -m 0755 src/remotix             $(B)/usr/libexec/remotix/remotix
	install -D -m 0644 src/page.html         $(B)/usr/share/remotix/page.html
ifeq ($(REMOTIX_LABWC_OSPITE),1)
	install -D -m 0755 debian/labwc-root/usr/lib/remotix/labwc $(B)/usr/lib/remotix/labwc
endif
	install -D -m 0644 debian/remotix.conf     $(B)/usr/share/remotix/remotix.conf
	# LICENSE.md §8: the licences of the third-party components inside the package, with their texts
	install -D -m 0644 THIRD-PARTY-LICENSES     $(B)/usr/share/doc/remotix/THIRD-PARTY-LICENSES
	# R24 (T8): the versions of the LINKED static libraries, read by pkg-config in the
	#    container that built the binary: the archive's SBOM reads them.
	printf '{"format":"remotix-linked/1","ngtcp2":"%s","nghttp3":"%s","source":"pkg-config of the linked .a files"}\n' \
	  "$$(pkg-config --modversion libngtcp2)" "$$(pkg-config --modversion libnghttp3)" \
	  >$(B)/usr/share/remotix/linked.json
	install -d -m 0755                         $(B)/etc/remotix/remotix.conf.d
	# Debian/Ubuntu PAM (common-*; phases/17 §4.3) and who may not log in (root).
	# Both are conffiles: dpkg keeps them on remove and deletes them on purge.
	install -D -m 0644 src/remotix.pam         $(B)/etc/pam.d/remotix
	install -D -m 0644 debian/denied-users    $(B)/etc/remotix/denied-users
	# ufw: the «REMOTIX» application profile (7447 TCP and UDP), DEFINED and not
	#    opened (§10.12, like the firewalld service in the .rpm): `ufw allow REMOTIX`
	#    is done by the engine, with consent (D6), if ufw is on (phases/17 T6).
	install -D -m 0644 debian/remotix.ufw      $(B)/etc/ufw/applications.d/remotix
	# KWin's capture permission.  ⛔ BYTE FOR BYTE the .rpm one (Arch's differs only
	# in Exec=), with Exec= on the binary in /usr/libexec/remotix:
	# the package ships it and the program only checks it at start-up
	# (kwin_check_permission(), kwin.c; RX-KDE-001..003), it never writes it.
	install -D -m 0644 debian/org.kde.remotix.desktop \
	  $(B)/usr/share/applications/org.kde.remotix.desktop
	# ⛔ DECISIONI §10.12 — the package carries only INERT PIECES: the three belts
	#    of §4.7 sit SWITCHED OFF in /usr/share/remotix/belts/ (nobody reads them
	#    there); the ENGINE puts them into force, with consent (D4), and records them in
	#    its log.
	install -D -m 0644 src/remotix-no-poweroff.rules \
	  $(B)/usr/share/polkit-1/rules.d/50-remotix-no-poweroff.rules
	install -D -m 0644 src/remotix-power-keys.conf \
	  $(B)/usr/share/remotix/belts/remotix-power-keys.conf
	install -D -m 0644 debian/remotix-no-suspend.conf \
	  $(B)/usr/share/remotix/belts/remotix-no-suspend.conf

execute_after_dh_auto_install:
ifeq ($(REMOTIX_SPLIT),1)
	install -D -m 0755 debian/remotix-net-move $(B)/usr/libexec/remotix/remotix-net-move
	# ⚠ Not dh_installsysusers: it is in dh's sequence only from compat 14 (`[M]` 16 Oct 2026: debhelper
	#    13.24.2 at compat 13 installed nothing); the postinst runs `systemd-sysusers remotix.conf`.
	install -D -m 0644 debian/remotix.sysusers $(B)/usr/lib/sysusers.d/remotix.conf
	# ⭐ 1.5 (AppArmor, NOT TRIED): the network side's profile `remotix_network`, in COMPLAIN mode (it logs, it confines nothing
	#    yet), a conffile in /etc/apparmor.d.  dh_apparmor (package dh-apparmor, run here, before dh_installdeb) writes the
	#    load / reload lines of postinst; the unload on removal is in debian/remotix.postrm.
	install -D -m 0644 debian/remotix_network.apparmor $(B)/etc/apparmor.d/remotix_network
	dh_apparmor --profile-name=remotix_network -premotix
endif


override_dh_installtmpfiles:
ifeq ($(REMOTIX_SPLIT),1)
	cp debian/remotix.tmpfiles.split debian/remotix.tmpfiles
endif
	dh_installtmpfiles

override_dh_installsystemd:
ifeq ($(REMOTIX_SPLIT),1)
	cp debian/remotix.service.split debian/remotix.service
endif
	# ⛔ DECISIONI §10.12: the package does NOT enable and does NOT start the service: the
	#    engine switches it on once the installation is confirmed.  On upgrade it
	#    restarts it (deb-systemd-invoke restart) ONLY if it was already active or enabled;
	#    it does not stop it first: the desktops survive the stop (§5.2).
	dh_installsystemd --no-enable --no-start --restart-after-upgrade
