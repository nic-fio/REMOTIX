# remotix-install.install — the scripts of the engine's Arch package.
# After an upgrade (pacman -Syu: REMOTIX updates with the system, DECISIONI §10.23) the engine
# records the versions and says whether the installation is still certified (§10.12 point 4). It never
# makes pacman fail.

post_upgrade() {
	/usr/bin/remotix-install post-upgrade
	return 0
}
