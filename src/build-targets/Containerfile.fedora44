# Containerfile.fedora44 — REMOTIX build for Fedora 44.
#
# Phase 18, without ffmpeg: `opus-devel` from Fedora (OpenH264 and SVT-AV1, the software
# fallback, left with phase 19).  The VA drivers with H.264 for the client
# come from RPM Fusion (§4.2).
# ngtcp2 and nghttp3 inside, static (Fedora's are 1.21).
# ⭐ Phase 19 (Vulkan Video, `src/vulkanvideo.c`): `vulkan-loader-devel` (brings
#    `vulkan-headers`), `[M]` 1 Oct 2026 in the image: 1.4.341.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False \
        gcc make pkgconf-pkg-config git cmake ninja-build diffutils \
        openssl-devel pam-devel glib2-devel pipewire-devel libdrm-devel \
        libva-devel opus-devel "pkgconfig(zlib)" \
        libei-devel libxkbcommon-devel mesa-libgbm-devel wayland-devel vulkan-loader-devel \
    && dnf clean all

# --- the same for all targets: nghttp3 1.18.0 and ngtcp2 1.25.0, static
COPY quic-static.sh /usr/local/bin/quic-static.sh
RUN sh /usr/local/bin/quic-static.sh
ENV LIBRARY_PATH=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
WORKDIR /albero/src

# --- PIANO «Correzione B»: what OUR labwc (labwc 0.9.3 + a patched, static wlroots 0.19.2, built by
#     packaging/labwc-ospite/build.sh from tarballs) needs to be built on Fedora 44.  The BuildRequires of
#     packaging/rpm/remotix.spec.  A layer AT THE END: the ones above stay cached.
RUN dnf -y install --setopt=install_weak_deps=False meson patch "pkgconfig(hwdata)" \
        "pkgconfig(wayland-server)" "pkgconfig(wayland-protocols)" "pkgconfig(cairo)" \
        "pkgconfig(pangocairo)" "pkgconfig(libinput)" "pkgconfig(libxml-2.0)" \
        "pkgconfig(pixman-1)" "pkgconfig(libpng16)" "pkgconfig(egl)" "pkgconfig(glesv2)" \
        "pkgconfig(libseat)" "pkgconfig(libudev)" "pkgconfig(libdisplay-info)" "pkgconfig(xkbcommon)" \
    && dnf clean all
