# Containerfile.alma10 — REMOTIX build for AlmaLinux 10 (with EPEL and CRB).
#
# The -devel packages are partly in CRB (libei, pipewire); phase 18, without ffmpeg:
# `opus-devel` (EPEL).  (`noopenh264-devel` and `svt-av1-devel`, the software
# fallback, left with phase 19.)
# ngtcp2 and nghttp3 inside, static (EPEL's is 1.22).
# ⭐ Phase 19 (Vulkan Video, `src/vulkanvideo.c`): `vulkan-loader-devel` (brings
#    `vulkan-headers`), `[M]` 1 Oct 2026 in the image: 1.4.328, in AppStream (not CRB).
FROM docker.io/library/almalinux:10
RUN dnf -y install epel-release dnf-plugins-core \
    && dnf config-manager --set-enabled crb \
    && dnf -y install --setopt=install_weak_deps=False \
        gcc make pkgconf-pkg-config git cmake ninja-build diffutils \
        openssl-devel pam-devel glib2-devel pipewire-devel libdrm-devel \
        libva-devel opus-devel \
        libei-devel libxkbcommon-devel mesa-libgbm-devel wayland-devel vulkan-loader-devel \
    && dnf clean all

# --- the same for all targets: nghttp3 1.18.0 and ngtcp2 1.25.0, static
COPY quic-static.sh /usr/local/bin/quic-static.sh
RUN sh /usr/local/bin/quic-static.sh
ENV LIBRARY_PATH=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
WORKDIR /albero/src

# --- 11 Oct 2026 (DECISIONI §10.43): what OUR labwc needs to be built on Alma 10 (EPEL has no
#     labwc): wlroots 0.18 from EPEL and the rest of Fedora's labwc 0.8.4 BuildRequires.  A layer
#     AT THE END: the ones above stay cached.  The other targets build no labwc.
RUN dnf -y install --setopt=install_weak_deps=False meson "pkgconfig(wlroots-0.18)" \
        "pkgconfig(wayland-server)" "pkgconfig(wayland-protocols)" "pkgconfig(cairo)" \
        "pkgconfig(pangocairo)" "pkgconfig(libinput)" "pkgconfig(libxml-2.0)" \
        "pkgconfig(pixman-1)" "pkgconfig(libpng16)" \
    && dnf clean all
