# Containerfile.ubuntu2604 — REMOTIX build for Ubuntu 26.04 LTS.
#
# The development dependencies from the distribution (apt); ngtcp2 and nghttp3 inside,
# static (quic-static.sh, §6.3; Ubuntu's is 1.16).
# ⭐ Phase 19 (Vulkan Video, `src/vulkanvideo.c`): `libvulkan-dev` — the loader and the
#    headers, `[M]` 1 Oct 2026 in the image: 1.4.341 (Ubuntu 26.04).
FROM docker.io/library/ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config git ca-certificates cmake ninja-build \
        libssl-dev libpam0g-dev \
        libglib2.0-dev libpipewire-0.3-dev libdrm-dev \
        libva-dev libopus-dev zlib1g-dev \
        libei-dev libxkbcommon-dev libgbm-dev libwayland-dev libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*

# --- the same for all targets: nghttp3 1.18.0 and ngtcp2 1.25.0, static
COPY quic-static.sh /usr/local/bin/quic-static.sh
RUN sh /usr/local/bin/quic-static.sh
ENV LIBRARY_PATH=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
WORKDIR /albero/src

# --- phase 17, T3: the tools for the .deb package (packaging/debian/).
#     A layer AT THE END, so that the layers above (and the static libraries) stay
#     cached: `build-deb.sh` uses it, `build-all.sh` does not.
RUN apt-get update && apt-get install -y --no-install-recommends \
        debhelper dh-apparmor dpkg-dev fakeroot lintian binutils \
    && rm -rf /var/lib/apt/lists/*

# --- PIANO «Correzione B»: what OUR labwc (labwc 0.9.3 + a patched, static wlroots 0.19.2, built by
#     packaging/labwc-ospite/build.sh from tarballs) needs on Ubuntu 26.04: the Build-Depends that
#     build-deb.sh adds to debian/control for this target.  Another layer at the end.
RUN apt-get update && apt-get install -y --no-install-recommends \
        meson patch hwdata wayland-protocols libegl-dev libgles-dev libinput-dev \
        libpixman-1-dev libseat-dev libudev-dev libdisplay-info-dev libxml2-dev \
        libcairo2-dev libpango1.0-dev libpng-dev \
    && rm -rf /var/lib/apt/lists/*
