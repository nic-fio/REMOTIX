# Containerfile.tumbleweed — REMOTIX build for openSUSE Tumbleweed.
#
# Phase 18, without ffmpeg: `libopus-devel`.  (OpenH264 and SVT-AV1, the software
# fallback, left with phase 19.)
# ⓘ Tumbleweed already has ngtcp2 1.25 with crypto_ossl: it could be used.
#   Ours is built anyway, static, for uniformity (§6.3).
# ⭐ Phase 19 (Vulkan Video, `src/vulkanvideo.c`): `vulkan-devel` (loader and
#    headers), `[M]` 1 Oct 2026 in the image: 1.4.357.
FROM registry.opensuse.org/opensuse/tumbleweed:latest
RUN zypper -n refresh && zypper -n install --no-recommends \
        gcc make pkg-config git cmake ninja diffutils \
        libopenssl-devel pam-devel glib2-devel pipewire-devel libdrm-devel \
        libva-devel libopus-devel zlib-devel \
        libei-devel libxkbcommon-devel 'pkgconfig(gbm)' wayland-devel vulkan-devel \
    && zypper -n clean -a

# --- the same for all targets: nghttp3 1.18.0 and ngtcp2 1.25.0, static
COPY quic-static.sh /usr/local/bin/quic-static.sh
RUN sh /usr/local/bin/quic-static.sh
ENV LIBRARY_PATH=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
WORKDIR /albero/src

# --- PIANO «Correzione B»: what OUR labwc (labwc 0.9.3 + a patched, static wlroots 0.19.2, built by
#     packaging/labwc-ospite/build.sh from tarballs) needs to be built on Tumbleweed.  The BuildRequires of
#     packaging/rpm/remotix.spec.  A layer AT THE END: the ones above stay cached.
RUN zypper -n install --no-recommends meson patch "pkgconfig(hwdata)" \
        "pkgconfig(wayland-server)" "pkgconfig(wayland-protocols)" "pkgconfig(cairo)" \
        "pkgconfig(pangocairo)" "pkgconfig(libinput)" "pkgconfig(libxml-2.0)" \
        "pkgconfig(pixman-1)" "pkgconfig(libpng16)" "pkgconfig(egl)" "pkgconfig(glesv2)" \
        "pkgconfig(libseat)" "pkgconfig(libudev)" "pkgconfig(libdisplay-info)" "pkgconfig(xkbcommon)" \
    && zypper -n clean -a
