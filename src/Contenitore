# Contenitore — ⭐ HOW REMOTIX IS BUILT, and without `sudo`.
#
# ---------------------------------------------------------------------------
# ⛔ WHY IT EXISTS: the block of the night of 14 August 2026
#
# `fasi/rapporti/F4-IN-12-mandato-prossima-sessione.md` §3 declared a block:
# *"I could not build the C.  And until it builds, every new line
# is code nobody has ever seen run."*  The three ways tried:
#
#   · this laptop (`CHUWI`)             `nghttp3`, `ngtcp2` and
#                                       `libswscale` missing ⇒ `make` stops
#   · test machine (192.168.0.2)        no `gcc`, no `make`: the rootfs
#                                       is live in RAM
#   · inside `/media/REMOTIX/enter.sh`  `gcc` is there, ⛔ but `/media/REMOTIX` is not
#                                       mounted and the `/srv/src` seen
#                                       inside is NOT the host's
#
# ⭐ The fourth way, and it is the one that breaks the block: **a container
#    built here, without privileges** — `podman` as a user, the source tree
#    mounted inside, and the binary that comes out **on the host**.  ⛔ No `sudo`:
#    the user is root only INSIDE the container, which is precisely the place
#    where `apt` is needed.
#
# ---------------------------------------------------------------------------
# ⛔ THE TWO LIBRARIES NOT TAKEN FROM `apt`, AND WHY
#
# The `Makefile` asks for `ngtcp2 >= 1.25` and `nghttp3 >= 1.18`; Debian Trixie carries
# 1.11 and 1.8.  ⚠ It is not a version preference: `ngtcp2_crypto_ossl` — the
# bridge to OpenSSL 3.5's **native** QUIC API, the one
# `src/tls.c` rests on — is not in the packaged versions at all.  ⇒ They are built
# from source, in here, once only: the image keeps them.
#
# ⚠ And the TAGS are pinned, not `main`: an image rebuilt in a month
#   with two different libraries is not the same image, and the day the
#   product stopped compiling nobody would know whether it is our fault.
#
# ---------------------------------------------------------------------------
#   podman build -t remotix-costruzione -f src/Contenitore src/
#   bash src/costruisci-in-contenitore.sh
FROM docker.io/library/debian:13

ENV DEBIAN_FRONTEND=noninteractive

# ⛔ The dependencies are those DECLARED in the `Makefile`, line by line: if one
#    is missing here, `make dipendenze` says so by name instead of making the
#    compiler fail on an `#include` nobody connects to the missing library.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config git ca-certificates \
        cmake ninja-build \
        libssl-dev libpam0g-dev \
        libglib2.0-dev libpipewire-0.3-dev libdrm-dev \
        libva-dev \
        libei-dev libxkbcommon-dev \
    && rm -rf /var/lib/apt/lists/*

# nghttp3 — HTTP/3, that is the half that carries extended CONNECT (RFC 9220).
RUN git clone --depth 1 -b v1.18.0 --recursive \
        https://github.com/ngtcp2/nghttp3 /tmp/nghttp3 \
    && cmake -B /tmp/nghttp3/build -S /tmp/nghttp3 -GNinja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DENABLE_LIB_ONLY=ON -DBUILD_SHARED_LIBS=ON \
    && ninja -C /tmp/nghttp3/build install \
    && rm -rf /tmp/nghttp3

# ngtcp2 — QUIC, ⛔ with `ENABLE_OPENSSL`: it is what builds
# `libngtcp2_crypto_ossl`, the bridge the `Makefile` links FIRST.
RUN git clone --depth 1 -b v1.25.0 --recursive \
        https://github.com/ngtcp2/ngtcp2 /tmp/ngtcp2 \
    && cmake -B /tmp/ngtcp2/build -S /tmp/ngtcp2 -GNinja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DENABLE_OPENSSL=ON -DENABLE_LIB_ONLY=ON -DBUILD_SHARED_LIBS=ON \
    && ninja -C /tmp/ngtcp2/build install \
    && rm -rf /tmp/ngtcp2

# ⭐ PHASE 13 — `libgbm-dev`: the CARD path on wlroots (`src/wlroots.c`).
#    The buffer into which labwc copies the frame on the GPU is allocated by US, and
#    `gbm` is the only generic API to allocate it on a `renderD*` node.
#    ⚠ In a layer of ITS OWN, at the bottom, and not in the `apt` line above: so
#    the ngtcp2 layer stays cached and the image is redone in seconds, not
#    in four minutes.  ⛔ The runtime `libgbm1` was already there (pulled
#    in by `libva-wayland2`): only the header was missing.
RUN apt-get update && apt-get install -y --no-install-recommends libgbm-dev \
    && rm -rf /var/lib/apt/lists/*

# ⭐ Phase 18 (`fasi/18-senza-ffmpeg.md`): the libraries that take the place of
#    ffmpeg — libopus directly.  ⛔ No libavcodec/libavutil/libswscale: the
#    product no longer names them, and an image that had them would hide a
#    leftover `#include`.  No libyuv: the colours are ours
#    (`src/colori709.c`).  ⛔ Phase 19: no OpenH264 and SVT-AV1 — the software
#    fallback is gone, and for the same reason the image does not have them.  In
#    a layer of its own, like `libgbm-dev`.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopus-dev \
    && rm -rf /var/lib/apt/lists/*

# ⭐ Phase 19 (`fasi/19-nvidia.md`, `DECISIONI.md` §10.27): Vulkan Video — the
#    card path tried BEFORE VA-API (`src/vulkanvideo.c`).
#    Only the loader and the headers are needed (`libvulkan-dev`, Apache-2.0): the
#    shader's SPIR-V is already in the repository, the shader compiler is not
#    needed, and the drivers (ICD) live in the system that runs the product.
#    `[M]` 1 Oct 2026: Debian 13 carries libvulkan-dev 1.4.309.  In a layer
#    of its own, like the others.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ldconfig
ENV PKG_CONFIG_PATH=/usr/local/lib/x86_64-linux-gnu/pkgconfig:/usr/local/lib/pkgconfig

WORKDIR /albero/src
