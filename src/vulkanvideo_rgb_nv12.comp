#version 450
/*
 * vulkanvideo_rgb_nv12.comp — RGB → NV12 / P010, BT.709 limitato, sulla
 * scheda.  E' `colori709.c` riscritto per lo shader di calcolo: gli STESSI
 * coefficienti in virgola fissa a 15 bit, lo stesso filtro di croma (somma
 * delle coppie orizzontali, tenda 1-3-3-1 su quattro righe), gli stessi
 * arrotondamenti ⇒ gli stessi byte, bit per bit (`[M]` nel banco 19).
 *
 * Ogni invocazione fa un blocco 2x2 di pixel: quattro campioni di luma e un
 * campione di croma.  La sorgente e' un'immagine campionata (`texelFetch`,
 * mai interpolata): il formato Vulkan dell'immagine (B8G8R8A8 per XRGB8888,
 * R8G8B8A8 per XBGR8888) mette gia' i canali nell'ordine R, G, B — lo shader
 * non sa in che ordine stavano in memoria.
 *
 * I piani d'uscita non hanno il qualificatore di formato (serve la
 * caratteristica `shaderStorageImageWriteWithoutFormat`): lo stesso SPIR-V
 * scrive R8/R8G8 (NV12) e R16/R16G16 (P010, dieci bit in ALTO).
 *
 * Si compila con `glslc -O -mfmt=c` in `vulkanvideo_rgb_nv12_spv.h`
 * (`banchi/19-vulkan/19-shader.sh`); l'intestazione generata si conserva nel
 * deposito, cosi' il prodotto non ha bisogno del compilatore di shader.
 */
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D sorgente;
layout(binding = 1) uniform writeonly image2D piano_y;
layout(binding = 2) uniform writeonly image2D piano_uv;

layout(push_constant) uniform Parametri {
	uint larghezza;   /* la tela (i pixel veri della sorgente) */
	uint altezza;
	uint larghezza_codificata; /* l'immagine d'ingresso, allineata al blocco */
	uint altezza_codificata;
	uint prof10;      /* 0 = NV12, 1 = P010 */
} p;

/* I coefficienti di `colori709.c`, SCALA 15: la luma somma 28142 = 219/255 ·
 * 32768 (bianco → 235), le due terne di croma sommano 0 (grigio → 128). */
const ivec3 CY = ivec3(5983, 20127, 2032);
const ivec3 CU = ivec3(-3298, -11094, 14392);
const ivec3 CV = ivec3(14392, -13072, -1320);

/* Un pixel in interi 0..255, con i bordi replicati: oltre la tela si rilegge
 * l'ultimo pixel (la fascia fino al blocco non e' spazzatura). */
ivec3 pixel(int x, int y)
{
	x = clamp(x, 0, int(p.larghezza) - 1);
	y = clamp(y, 0, int(p.altezza) - 1);
	vec3 c = texelFetch(sorgente, ivec2(x, y), 0).rgb;
	return ivec3(round(c * 255.0));
}

/* `riga()`: Y = (k·Σc·byte + (16k << 15) + (1 << 14)) >> 15. */
void luma(int x, int y, int k)
{
	ivec3 c = pixel(x, y);
	int s = CY.r * c.r + CY.g * c.g + CY.b * c.b; /* in INTERI: il prodotto supera i 24 bit del float */
	int Y = (k * s + ((16 * k) << 15) + (1 << 14)) >> 15;
	float v = (p.prof10 != 0u) ? float(Y * 64) / 65535.0 : float(Y) / 255.0;
	imageStore(piano_y, ivec2(x, y), vec4(v, 0.0, 0.0, 0.0));
}

void main()
{
	int cx = int(gl_GlobalInvocationID.x);
	int cy = int(gl_GlobalInvocationID.y);
	if (cx >= int(p.larghezza_codificata) / 2 || cy >= int(p.altezza_codificata) / 2)
		return;
	int k = (p.prof10 != 0u) ? 4 : 1;
	int x = 2 * cx, y = 2 * cy;

	luma(x, y, k);
	luma(x + 1, y, k);
	luma(x, y + 1, k);
	luma(x + 1, y + 1, k);

	/* `croma()`: le righe 2cy-1 … 2cy+2 (ferme ai bordi), pesi 1 3 3 1, e in
	 * ogni riga la somma della coppia di pixel; poi la matrice.  Lo
	 * spostamento e' SCALA + 4 = 19: 2 pixel · (1+3+3+1) = 16. */
	ivec3 w = ivec3(0);
	for (int j = 0; j < 4; j++) {
		int r = y - 1 + j;
		int peso = (j == 0 || j == 3) ? 1 : 3;
		w += peso * (pixel(x, r) + pixel(x + 1, r));
	}
	int off = ((128 * k) << 19) + (1 << 18);
	int U = (k * (CU.r * w.r + CU.g * w.g + CU.b * w.b) + off) >> 19;
	int V = (k * (CV.r * w.r + CV.g * w.g + CV.b * w.b) + off) >> 19;
	vec2 uv = (p.prof10 != 0u) ? vec2(U * 64, V * 64) / 65535.0 : vec2(U, V) / 255.0;
	imageStore(piano_uv, ivec2(cx, cy), vec4(uv, 0.0, 0.0));
}
