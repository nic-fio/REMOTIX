#%PAM-1.0
# remotix — il servizio PAM del server REMOTIX.  ⭐ FEDORA, RHEL, ROCKY, ALMA.
#
#   si installa in /etc/pam.d/remotix
#
# ⭐ `DECISIONI.md` §10.18 (D3 chiusa, 30 set 2026): REMOTIX RISPECCHIA
#    l'autenticazione del sistema.  Questo file e' /etc/pam.d/sshd della
#    distribuzione, riga per riga, con UNA riga in piu' in testa: root escluso
#    (come ssh di serie, che a root non accetta la parola d'ordine).
#    `[M]` 30 set, confronto con /etc/pam.d/sshd su fedora44-gnome-iso e
#    alma10-gnome-iso (identici fra loro): 14 righe su 14 uguali
#    (`banchi/17-t6/t6-leggi-pam.sh`).
#    ⇒ Quel che l'amministratore configura per ssh con `authselect` (per
#      esempio `with-faillock`: tre errori e il conto si chiude) vale anche qui,
#      senza toccare questo file.
#
# ⛔ Niente `@include`: e' una modifica di Debian a Linux-PAM, e qui la riga
#    sarebbe «illegal module type» — e l'autenticazione fallirebbe per tutti.
# ⛔ Se questo file manca, PAM ripiega su `other`, che qui e' `pam_deny`:
#    ogni parola d'ordine giusta rifiutata.  `main.c` lo guarda all'avvio.
#
# ⭐ `pam_selinux close/open` c'e', come in sshd: la sessione dell'utente nasce
#    nel SUO contesto (`unconfined_t` per un utente normale), non in quello del
#    servizio.  Il passaggio lo permette il modulo SELinux di REMOTIX
#    (`remotix-selinux`, `packaging/rpm/selinux/remotix.te`), come fa
#    `cockpit-ws-selinux` per Cockpit.  `[M]` T1c, 29 set: senza il modulo il
#    figlio esce con 37 (`{ transition } unconfined_service_t → unconfined_t`).

# ── auth
# ⭐ ROOT ESCLUSO, e PRIMA della parola d'ordine: le ragioni (requisite, in
#    auth e non in account, onerr=fail) sono scritte in `remotix.pam`.  Il
#    file elenca un nome per riga e si installa con dentro `root`.
auth       requisite    pam_listfile.so item=user sense=deny file=/etc/remotix/utenti-negati onerr=fail
auth       substack     password-auth
auth       include      postlogin

# ── account (`autenticazione.c` chiama `pam_acct_mgmt` apposta)
account    required     pam_sepermit.so
account    required     pam_nologin.so
account    include      password-auth

password   include      password-auth

# ── session: `figlio.c` chiama `pam_open_session`, ed e' quella chiamata che
#    fa nascere la sessione logind dell'utente.  `pam_systemd` arriva da
#    `password-auth` (`-session optional pam_systemd.so`), come per sshd.
# ⚠ `pam_loginuid` `required` come sshd: il servizio parte da systemd, senza
#   loginuid, e lo puo' scrivere.  Un server lanciato a mano da una sessione
#   gia' aperta (che ha il suo loginuid, immutabile) NON apre sessioni: e' il
#   comportamento di sshd lanciato allo stesso modo.
session    required     pam_selinux.so close
session    required     pam_loginuid.so
session    required     pam_selinux.so open env_params
session    required     pam_namespace.so
session    optional     pam_keyinit.so force revoke
session    optional     pam_motd.so
session    include      password-auth
session    include      postlogin
