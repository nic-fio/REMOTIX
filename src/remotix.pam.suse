#%PAM-1.0
# remotix — il servizio PAM del server REMOTIX.  ⭐ openSUSE (Leap, Tumbleweed).
#
#   ⛔ si installa in /usr/lib/pam.d/remotix, NON in /etc/pam.d: openSUSE
#      tiene i file dei pacchetti in /usr/lib/pam.d, e /etc/pam.d resta
#      all'amministratore (un suo /etc/pam.d/remotix vince sul nostro).
#
# ⭐ `DECISIONI.md` §10.18 (D3 chiusa, 30 set 2026): REMOTIX RISPECCHIA
#    l'autenticazione del sistema.  Questo file e' /usr/lib/pam.d/sshd della
#    distribuzione, riga per riga, con UNA riga in piu' in testa: root escluso.
#    `[M]` 30 set, confronto con tumbleweed-kde-iso e leap16-kde (identici fra
#    loro): 13 righe su 13 uguali (`banchi/17-t6/t6-leggi-pam.sh`).
#    ⇒ Quel che l'amministratore mette in `common-*` con `pam-config` (per
#      esempio `pam_faillock`) vale anche qui.
#
# ⚠ `common-session` (non piu' `common-session-nonlogin`): e' quella di sshd.
#   Con SELinux acceso `pam-config` ci mette `pam_selinux close/open` (`[M]`
#   Tumbleweed e Leap 16 in enforcing): la sessione dell'utente nasce nel SUO
#   contesto, e il passaggio lo permette il modulo `remotix-selinux`.
#   `pam_systemd` arriva da li' (senza, il desktop non nasce): non si ripete.
#
# ⛔ Niente `@include`: e' una modifica di Debian a Linux-PAM, e qui la riga
#    sarebbe «illegal module type».

# ── auth
# ⭐ ROOT ESCLUSO, e PRIMA della parola d'ordine: le ragioni (requisite, in
#    auth e non in account, onerr=fail) sono scritte in `remotix.pam`.  Il
#    file elenca un nome per riga e si installa con dentro `root`.
auth       requisite    pam_listfile.so item=user sense=deny file=/etc/remotix/utenti-negati onerr=fail
auth       requisite    pam_nologin.so
auth       substack     common-auth
auth       include      postlogin-auth

# ── account (`autenticazione.c` chiama `pam_acct_mgmt` apposta)
account    requisite    pam_nologin.so
account    substack     common-account
account    include      postlogin-account

password   substack     common-password
password   include      postlogin-password

# ── session: `figlio.c` chiama `pam_open_session`, ed e' quella chiamata che
#    fa nascere la sessione logind dell'utente.
# ⚠ `pam_loginuid` `required` come sshd: le ragioni in `remotix.pam.fedora`.
session    required     pam_loginuid.so
session    optional     pam_keyinit.so force revoke
session    substack     common-session
session    include      postlogin-session
session    optional     pam_motd.so
