#%PAM-1.0
# remotix — the PAM service of the REMOTIX server.  ⭐ ARCH, MANJARO.
#
#   installed in /etc/pam.d/remotix
#
# ⭐ PHASE 17 (`fasi/17-l-installatore.md` §4.3): the same job as
#    `remotix.pam` (Debian), written with `pambase`'s stacks.  ⛔ No
#    `@include`: it is a Debian modification to Linux-PAM, and here the line would be
#    "illegal module type".
#
# ⭐ `system-remote-login` is the stack Arch gives to NETWORK accesses (sshd
#    uses it): it includes `system-login`, which brings `pam_loginuid`, `pam_keyinit` and
#    ⛔ `pam_systemd` — without it, the desktop is not born — and `system-auth`, which
#    brings `pam_systemd_home` (systemd-homed users; `[?]` to be measured).
#    ⇒ `pam_systemd` is NOT repeated here: a second call would find the
#    session already open.
#    ⚠ If one day the shorter stack were needed, the alternative is
#    `system-auth` + `session optional pam_systemd.so` by name.
#
# ⛔ If this file is missing, PAM falls back to `other`, which here is `pam_deny`.

# ── auth
# ⭐ ROOT EXCLUDED, and BEFORE the password: the reasons (requisite, in
#    auth and not in account, onerr=fail) are written in `remotix.pam`.  The
#    file lists one name per line and is installed with `root` in it.
auth       requisite    pam_listfile.so item=user sense=deny file=/etc/remotix/utenti-negati onerr=fail
#
# ⭐ `DECISIONI.md` §10.18 (D3 closed, 30 Sep 2026): REMOTIX MIRRORS
#    the system's authentication.  Arch's /etc/pam.d/sshd is four lines
#    `include system-remote-login`: this file is that, with only the root
#    line extra (`[M]` 30 Sep, arch-kde-iso: 4 lines of 4 equal).
#    `pambase` puts `pam_faillock` in `system-auth` (deny=3 in 15 minutes,
#    lockout of 10): it holds for REMOTIX as for ssh, and is governed in
#    /etc/security/faillock.conf.  `faillock --user <name> --reset` unlocks.
auth       include      system-remote-login

# ── account (`autenticazione.c` calls `pam_acct_mgmt` on purpose)
account    include      system-remote-login

password   include      system-remote-login

# ── session: `figlio.c` calls `pam_open_session`, and it is that call that
#    makes the user's logind session be born.
session    include      system-remote-login
