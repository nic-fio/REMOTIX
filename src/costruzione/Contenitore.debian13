# Contenitore.debian13 — REMOTIX build for Debian 13 (the reference).
#
# The development dependencies from the distribution (apt); ngtcp2 and nghttp3 inside,
# static (quic-statiche.sh, §6.3).  Used with `costruisci-tutti.sh debian13`.
# ⓘ src/Contenitore stays the usual one (the .so files in /usr/local, for everyday
#   work and for costruisci-in-contenitore.sh): this is the
#   "packaging" target, the same as the other seven.
# ⭐ Phase 19 (Vulkan Video, `src/vulkanvideo.c`): `libvulkan-dev` — the loader and the
#    headers, `[M]` 1 Oct 2026 in the image: 1.4.309 (Debian 13).
FROM docker.io/library/debian:13
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config git ca-certificates cmake ninja-build \
        libssl-dev libpam0g-dev \
        libglib2.0-dev libpipewire-0.3-dev libdrm-dev \
        libva-dev libopus-dev \
        libei-dev libxkbcommon-dev libgbm-dev libwayland-dev libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*

# --- the same for all targets: nghttp3 1.18.0 and ngtcp2 1.25.0, static
COPY quic-statiche.sh /usr/local/bin/quic-statiche.sh
RUN sh /usr/local/bin/quic-statiche.sh
ENV LIBRARY_PATH=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
WORKDIR /albero/src

# --- phase 17, T3: the tools for the .deb package (packaging/debian/).
#     A layer AT THE END, so that the layers above (and the static libraries) stay
#     cached: `costruisci-deb.sh` uses it, `costruisci-tutti.sh` does not.
RUN apt-get update && apt-get install -y --no-install-recommends \
        debhelper dpkg-dev fakeroot lintian binutils \
    && rm -rf /var/lib/apt/lists/*
