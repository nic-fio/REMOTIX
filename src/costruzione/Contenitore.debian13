# Contenitore.debian13 — costruzione di REMOTIX per Debian 13 (il riferimento).
#
# Le dipendenze di sviluppo dalla distribuzione (apt); ngtcp2 e nghttp3 dentro,
# statiche (quic-statiche.sh, §6.3).  Si usa con `costruisci-tutti.sh debian13`.
# ⓘ src/Contenitore resta quello di sempre (le .so in /usr/local, per il lavoro
#   di tutti i giorni e per costruisci-in-contenitore.sh): questo e' il bersaglio
#   «da pacchetto», uguale agli altri sette.
# ⭐ Fase 19 (Vulkan Video, `src/vulkanvideo.c`): `libvulkan-dev` — il loader e le
#    intestazioni, `[M]` 1 ott 2026 nell'immagine: 1.4.309 (Debian 13).
FROM docker.io/library/debian:13
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config git ca-certificates cmake ninja-build \
        libssl-dev libpam0g-dev \
        libglib2.0-dev libpipewire-0.3-dev libdrm-dev \
        libva-dev libopus-dev \
        libei-dev libxkbcommon-dev libgbm-dev libwayland-dev libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*

# --- uguale per tutti i bersagli: nghttp3 1.18.0 e ngtcp2 1.25.0, statiche
COPY quic-statiche.sh /usr/local/bin/quic-statiche.sh
RUN sh /usr/local/bin/quic-statiche.sh
ENV LIBRARY_PATH=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
WORKDIR /albero/src

# --- fase 17, T3: gli attrezzi del pacchetto .deb (packaging/debian/).
#     Uno strato IN CODA, perche' gli strati di sopra (e le statiche) restino
#     quelli in cache: `costruisci-deb.sh` lo usa, `costruisci-tutti.sh` no.
RUN apt-get update && apt-get install -y --no-install-recommends \
        debhelper dpkg-dev fakeroot lintian binutils \
    && rm -rf /var/lib/apt/lists/*
