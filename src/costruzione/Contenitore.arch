# Contenitore.arch — REMOTIX build for Arch Linux.
#
# ⓘ Arch already has ngtcp2 1.25 with crypto_ossl (package `ngtcp2`): it could
#   be used.  Ours is built anyway, static, for uniformity
#   (a single transport version to test, §6.3).
#
# ⓘ labwc, wlr-randr, wireplumber and pipewire-pulse are not needed to compile: they are RUNTIME
#   dependencies of the package (packaging/arch/PKGBUILD), and makepkg wants to see them
#   installed before building.
# ⭐ Phase 19 (Vulkan Video, `src/vulkanvideo.c`): `vulkan-headers` + `vulkan-icd-loader`
#    (`[M]` 1 Oct 2026 in the image: 1.4.357).
FROM docker.io/library/archlinux:latest
RUN pacman -Syu --noconfirm --needed \
        base-devel git cmake ninja \
        openssl pam glib2 pipewire libdrm libva opus \
        libei libxkbcommon mesa wayland vulkan-headers vulkan-icd-loader \
        labwc wlr-randr wireplumber pipewire-pulse \
    && pacman -Scc --noconfirm

# --- the same for all targets: nghttp3 1.18.0 and ngtcp2 1.25.0, static
COPY quic-statiche.sh /usr/local/bin/quic-statiche.sh
RUN sh /usr/local/bin/quic-statiche.sh
ENV LIBRARY_PATH=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
WORKDIR /albero/src

# --- 11 Oct 2026 (DECISIONI §10.43): what OUR labwc needs to be built — the host of the nested
#     KWin, built from the pinned upstream sources by packaging/labwc/costruisci-labwc.sh inside the
#     package build, wlroots linked statically.  A layer AT THE END: the ones above stay cached.
RUN pacman -Syu --noconfirm --needed \
        meson wayland-protocols pixman libinput cairo pango libxml2 libpng libglvnd seatd \
        libdisplay-info hwdata systemd-libs \
    && pacman -Scc --noconfirm
