# Contenitore.fedora44 — REMOTIX build for Fedora 44.
#
# Phase 18, without ffmpeg: `opus-devel` from Fedora (OpenH264 and SVT-AV1, the software
# fallback, left with phase 19).  The VA drivers with H.264 for the client
# come from RPM Fusion (§4.2).
# ngtcp2 and nghttp3 inside, static (Fedora's are 1.21).
# ⭐ Phase 19 (Vulkan Video, `src/vulkanvideo.c`): `vulkan-loader-devel` (brings
#    `vulkan-headers`), `[M]` 1 Oct 2026 in the image: 1.4.341.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False \
        gcc make pkgconf-pkg-config git cmake ninja-build diffutils \
        openssl-devel pam-devel glib2-devel pipewire-devel libdrm-devel \
        libva-devel opus-devel \
        libei-devel libxkbcommon-devel mesa-libgbm-devel wayland-devel vulkan-loader-devel \
    && dnf clean all

# --- the same for all targets: nghttp3 1.18.0 and ngtcp2 1.25.0, static
COPY quic-statiche.sh /usr/local/bin/quic-statiche.sh
RUN sh /usr/local/bin/quic-statiche.sh
ENV LIBRARY_PATH=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
WORKDIR /albero/src

# --- 11 Oct 2026 (DECISIONI §10.43): what OUR labwc needs to be built — the host of the nested
#     KWin, built from the pinned upstream sources by packaging/labwc/costruisci-labwc.sh inside the
#     package build, wlroots linked statically.  A layer AT THE END: the ones above stay cached.
#     ⚠ Alma 10: libseat-devel comes from EPEL, libinput/libdisplay-info/hwdata-devel/meson from CRB.
RUN dnf -y install --setopt=install_weak_deps=False meson hwdata \
        "pkgconfig(wayland-protocols)" "pkgconfig(pixman-1)" "pkgconfig(libinput)" \
        "pkgconfig(cairo)" "pkgconfig(pangocairo)" "pkgconfig(libxml-2.0)" "pkgconfig(libpng16)" \
        "pkgconfig(egl)" "pkgconfig(glesv2)" "pkgconfig(libseat)" "pkgconfig(libdisplay-info)" \
        "pkgconfig(libudev)" "pkgconfig(hwdata)" \
    && dnf clean all
