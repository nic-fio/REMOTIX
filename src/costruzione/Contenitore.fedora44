# Contenitore.fedora44 — costruzione di REMOTIX per Fedora 44.
#
# Fase 18, senza ffmpeg: `openh264-devel` dal deposito `fedora-cisco-openh264`
# (acceso di serie; ⚠ NON `noopenh264-devel`, la copia vuota — le intestazioni
# bastano a compilare, e a esecuzione `ripiego.c` riconosce la copia vuota),
# `svt-av1-devel` e `opus-devel` da Fedora.  I driver VA con H.264 al cliente
# arrivano da RPM Fusion (§4.2).
# ngtcp2 e nghttp3 dentro, statiche (quelle di Fedora sono 1.21).
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False \
        gcc make pkgconf-pkg-config git cmake ninja-build diffutils \
        openssl-devel pam-devel glib2-devel pipewire-devel libdrm-devel \
        libva-devel openh264-devel svt-av1-devel opus-devel \
        libei-devel libxkbcommon-devel mesa-libgbm-devel wayland-devel \
    && dnf clean all

# --- uguale per tutti i bersagli: nghttp3 1.18.0 e ngtcp2 1.25.0, statiche
COPY quic-statiche.sh /usr/local/bin/quic-statiche.sh
RUN sh /usr/local/bin/quic-statiche.sh
ENV LIBRARY_PATH=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
WORKDIR /albero/src
